---
import Base from '../layouts/Base.astro';
---

<Base
  title="Contact"
  description="Book a free fifteen-minute consultation, or send a message about your athlete’s swim recruiting."
>

<!-- HERO -->
<header class="contact-hero">
  <div class="wrap">
    <div class="contact-hero-content">
      <span class="eyebrow">Contact Us</span>
      <h1>Let's talk about your athlete's <em>recruiting journey.</em></h1>
      <p>Send us a message and our team will follow up directly, or reach out to us anytime by email.</p>
      <a class="email-chip" href="mailto:info@signingdayadvisors.com">
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M3 6h18v12H3z" stroke="currentColor" stroke-width="1.4"/><path d="M3 7l9 6 9-6" stroke="currentColor" stroke-width="1.4"/></svg>
        info@signingdayadvisors.com
      </a>
    </div>
  </div>
</header>

<!-- CONTACT -->
<section class="contact-section">
  <div class="wrap contact-layout">

    <div class="contact-intro">
      <span class="eyebrow">Get in touch</span>
      <h2>We'd love to hear from your family.</h2>
      <p>Whether you have a question about our process, want to know which package is right for your athlete, or are ready to get started, fill out the form and we'll get back to you promptly.</p>
      <div class="contact-direct">
        <h4>Prefer email?</h4>
        <a href="mailto:info@signingdayadvisors.com">
          <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M3 6h18v12H3z" stroke="currentColor" stroke-width="1.4"/><path d="M3 7l9 6 9-6" stroke="currentColor" stroke-width="1.4"/></svg>
          info@signingdayadvisors.com
        </a>
      </div>
    </div>

    <form class="contact-form" id="contact-form">
      <input type="hidden" name="form_type" value="Website Contact Form">
      <div class="form-row">
        <div class="form-group">
          <label for="firstName">First Name</label>
          <input type="text" id="firstName" name="firstName" autocomplete="given-name" required>
        </div>
        <div class="form-group">
          <label for="lastName">Last Name</label>
          <input type="text" id="lastName" name="lastName" autocomplete="family-name" required>
        </div>
      </div>

      <div class="form-row">
        <div class="form-group">
          <label for="email">Email</label>
          <input type="email" id="email" name="email" autocomplete="email" required>
        </div>
        <div class="form-group">
          <label for="gradYear">Student's Year of Graduation</label>
          <select id="gradYear" name="gradYear" required>
            <option value="" disabled selected>Select a year</option>
            <option>2026</option>
            <option>2027</option>
            <option>2028</option>
            <option>2029</option>
            <option>2030</option>
            <option>2031</option>
            <option>2032</option>
            <option>Not sure yet</option>
          </select>
        </div>
      </div>

      <div class="form-group">
        <label for="subject">Subject</label>
        <select id="subject" name="subject" required>
          <option value="" disabled selected>Select a subject</option>
          <option>Free Consultation</option>
          <option>Question</option>
          <option>Partnership Inquiry</option>
          <option>Other</option>
        </select>
      </div>

      <div class="form-group">
        <label for="message">Message</label>
        <textarea id="message" name="message" required></textarea>
      </div>

      <div class="form-submit">
        <button class="btn-gold" type="submit" data-fs-submit-btn>Send Message</button>
        <span class="form-note">Our team will receive your message directly.</span>
      </div>
    <div class="form-status" data-fs-success>Thank you. Your message has been sent successfully.</div>
    <div class="form-status form-error" data-fs-error></div>
    </form>
  </div>
</section>

</Base>

<style is:global>
/* NAV */
nav{position:sticky;top:0;z-index:50;background:rgba(15,42,74,0.96);backdrop-filter:blur(8px);border-bottom:1px solid rgba(201,161,59,0.25)}
.nav-links .active{color:var(--gold-soft)}

/* HERO */
.contact-hero{background:var(--navy);color:#fff;padding:100px 0 88px;position:relative;overflow:hidden}
.contact-hero::after{content:"@";position:absolute;right:6%;top:50%;transform:translateY(-52%);font-family:'Fraunces',serif;font-size:300px;line-height:1;color:rgba(201,161,59,0.06);pointer-events:none}
.contact-hero-content{max-width:680px;position:relative;z-index:2}
.contact-hero .eyebrow{display:block;margin-bottom:20px}
.contact-hero h1{font-size:clamp(40px,5.5vw,58px);margin-bottom:20px}
.contact-hero h1 em{color:var(--gold-soft);font-style:italic}
.contact-hero p{max-width:560px;color:#C7D2DE;font-size:17px;margin-bottom:28px}
.email-chip{display:inline-flex;align-items:center;gap:10px;border:1px solid rgba(201,161,59,0.45);border-radius:2px;padding:12px 20px;font-family:'IBM Plex Mono',monospace;font-size:14px;color:var(--gold-soft);transition:all .2s}
.email-chip:hover{background:rgba(201,161,59,0.1);border-color:var(--gold)}
.email-chip svg{width:16px;height:16px;flex:none}

/* CONTACT SECTION */
.contact-section{padding:88px 0 104px}
.contact-layout{display:grid;grid-template-columns:.6fr 1.4fr;gap:72px;align-items:start}
.contact-intro{position:sticky;top:110px}
.contact-intro .eyebrow{display:block;margin-bottom:16px}
.contact-intro h2{color:var(--navy);font-size:32px;margin-bottom:18px}
.contact-intro p{color:var(--muted);font-size:15px;margin-bottom:26px}
.contact-direct{border-top:1px solid var(--line);padding-top:22px;margin-top:8px}
.contact-direct h4{font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:1.5px;text-transform:uppercase;color:var(--gold);margin-bottom:12px;font-weight:500}
.contact-direct a{color:var(--navy);font-size:16px;font-weight:600;display:inline-flex;align-items:center;gap:8px}
.contact-direct a:hover{color:var(--gold)}
.contact-direct a svg{width:16px;height:16px;flex:none}

.contact-form{background:#fff;border:1px solid var(--line);border-radius:6px;padding:42px;display:flex;flex-direction:column;gap:22px}
.form-row{display:grid;grid-template-columns:1fr 1fr;gap:20px}
.form-group{display:flex;flex-direction:column;gap:8px}
.form-group label{font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:1.5px;text-transform:uppercase;color:var(--navy);font-weight:500}
.form-group input,.form-group select,.form-group textarea{font-family:'Newsreader',serif;font-size:15px;color:var(--ink);background:var(--cream);border:1px solid var(--line);border-radius:2px;padding:13px 14px;width:100%}
.form-group input:focus,.form-group select:focus,.form-group textarea:focus{outline:none;border-color:var(--gold);background:#fff}
.form-group textarea{resize:vertical;min-height:150px}
.form-submit{display:flex;align-items:center;gap:18px;flex-wrap:wrap;margin-top:6px}
.btn-gold{display:inline-block;background:var(--gold);color:var(--navy);padding:14px 28px;border:none;border-radius:2px;font-size:14px;font-weight:600;font-family:'Newsreader',serif;cursor:pointer;transition:all .2s}
.btn-gold:hover{background:var(--gold-soft);transform:translateY(-1px)}
.form-note{font-size:13px;color:var(--muted)}
.form-status{font-size:13px;color:var(--navy);display:none;margin-top:4px}
.form-status:not(:empty){display:block}
.form-error{color:#9B3A3A}

/* FOOTER */
footer{background:var(--navy-deep);color:#8FA0B3;padding:56px 0 38px}

@media(max-width:900px){.contact-layout{grid-template-columns:1fr;gap:42px}.contact-intro{position:static}}
@media(max-width:760px){
  .contact-hero{padding:76px 0 68px}
  .contact-hero::after{display:none}
  .contact-section{padding:68px 0 78px}
  .contact-form{padding:28px}
  .form-row{grid-template-columns:1fr}
}
</style>

<script is:inline>
  window.formspree = window.formspree || function () {
    (formspree.q = formspree.q || []).push(arguments);
  };
  formspree('initForm', { formElement: '#contact-form', formId: 'xzeplgyb' });
</script>
<script is:inline defer src="https://unpkg.com/@formspree/ajax@1.1.5/dist/global.js"
  integrity="sha384-9fQrvHz7unHjhv7e+pJqhvNxPV4tYHHsSn3PxBIEyPTGY8Q/PAKM1sfhL+zTYmhc" crossorigin="anonymous"></script>
