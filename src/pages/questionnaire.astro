---
import Base from '../layouts/Base.astro';
---

<Base
  title="Recruiting Questionnaire"
  description="The SDA athlete questionnaire, completed after your first consultation."
  noindex
>

<header class="hero">
<div class="wrap">
<span class="eyebrow">Recruiting Assessment</span>
<h1>Help us understand <em>your athlete.</em></h1>
<p>This questionnaire gives our team the information needed to evaluate your athlete's recruiting position, athletic competitiveness, academic profile, college preferences, and next steps. This questionnaire is to be completed after your first consultation with one of our advisors.</p>
</div>
</header>

<div class="progress">
<div class="wrap">
<div class="progress-grid">
<div class="progress-step"><span class="progress-num">01</span><strong>Free Consultation</strong></div>
<div class="progress-step current"><span class="progress-num">02</span><strong>Athlete Questionnaire + SDA Evaluation</strong></div>
<div class="progress-step"><span class="progress-num">03</span><strong>Select Your Service</strong></div>
</div>
</div>
</div>

<section class="intro">
<div class="wrap">
<div class="intro-card">
<span class="eyebrow">Before You Begin</span>
<h2>A more complete picture leads to better guidance.</h2>
<p>Please complete this questionnaire with the student-athlete and at least one parent or guardian. Honest and complete answers allow us to provide a more useful and realistic assessment.</p>
<p><strong>Estimated completion time: 20–30 minutes</strong></p>
<p><strong>Please have ready:</strong></p>
<ul class="prep">
<li>Recent unofficial high-school transcript</li>
<li>Current swim times or SwimCloud profile</li>
<li>SAT, ACT, PSAT, or practice-test results</li>
<li>Current college list</li>
<li>Previous coach communications, if applicable</li>
<li>Upcoming meet and testing schedule</li>
</ul>
</div>
</div>
</section>

<section class="form-section">
<div class="wrap">

<form class="questionnaire" id="questionnaire-form" action="https://formspree.io/f/mzeplgqb" method="POST">

<input type="hidden" name="_subject" value="New SDA Recruiting Questionnaire">
<input type="hidden" name="form_type" value="Athlete Questionnaire">

<!-- SECTION 1 -->
<div class="form-card">
<div class="form-card-head">
<span class="eyebrow">Section 01</span>
<h2>Student-Athlete Information</h2>
</div>

<div class="form-row">
<div class="form-group">
<label for="athleteName">Student-Athlete Full Name</label>
<input type="text" id="athleteName" name="athlete_name" required>
</div>
<div class="form-group">
<label for="athleteContact">Student-Athlete Email / Phone</label>
<input type="text" id="athleteContact" name="athlete_contact" required>
</div>
</div>

<div class="form-row">
<div class="form-group">
<label for="gradYear">High-School Graduation Year</label>
<select id="gradYear" name="graduation_year" required>
<option value="" disabled selected>Select year</option>
<option>2027</option><option>2028</option><option>2029</option><option>2030</option><option>2031</option><option>Other</option>
</select>
</div>
<div class="form-group">
<label for="highSchool">High School</label>
<input type="text" id="highSchool" name="high_school" placeholder="Name and ZIP code" required>
</div>
</div>

<div class="form-row">
<div class="form-group">
<label for="clubTeam">Club / Travel Team</label>
<input type="text" id="clubTeam" name="club_team" required>
</div>
<div class="form-group">
<label for="coach">Primary Club Coach</label>
<input type="text" id="coach" name="primary_coach" placeholder="Name and contact information" required>
</div>
</div>

<div class="form-group">
<label for="yearsSwimming">Year-Round Swimming Experience</label>
<input type="text" id="yearsSwimming" name="years_swimming" placeholder="How long has the athlete competed year-round?" required>
</div>
</div>

<!-- SECTION 2 -->
<div class="form-card">
<div class="form-card-head">
<span class="eyebrow">Section 02</span>
<h2>Parent / Guardian Information</h2>
</div>

<div class="form-row">
<div class="form-group">
<label for="parentName">Parent / Guardian Name</label>
<input type="text" id="parentName" name="parent_name" placeholder="Name and relationship" required>
</div>
<div class="form-group">
<label for="parentContact">Parent / Guardian Contact</label>
<input type="text" id="parentContact" name="parent_contact" placeholder="Email and phone" required>
</div>
</div>

<div class="form-group">
<span class="question-label">Who Should Receive SDA Communications?</span>
<div class="options checkbox-group" data-group="communications">
<label class="option"><input type="checkbox" name="communications[]" value="Student-athlete" required>Student-athlete</label>
<label class="option"><input type="checkbox" name="communications[]" value="Parent/guardian">Parent / guardian</label>
<label class="option"><input type="checkbox" name="communications[]" value="Additional parent/guardian">Additional parent / guardian</label>
</div>
</div>

<div class="form-group">
<label for="additionalParent">Additional Parent / Guardian</label>
<input type="text" id="additionalParent" name="additional_parent" placeholder="Name and contact information, if applicable">
</div>
</div>

<!-- SECTION 3 -->
<div class="form-card">
<div class="form-card-head">
<span class="eyebrow">Section 03</span>
<h2>Swimming Profile</h2>
</div>

<div class="form-group">
<label for="swimcloud">SwimCloud Profile</label>
<input type="url" id="swimcloud" name="swimcloud_profile" placeholder="https://" required>
</div>

<div class="form-row">
<div class="form-group">
<label for="practices">Practices Per Week</label>
<input type="number" id="practices" name="practices_per_week" min="0" required>
</div>
<div class="form-group">
<label for="trainingHours">Training Hours Per Week</label>
<input type="number" id="trainingHours" name="training_hours_per_week" min="0" step=".5" required>
</div>
</div>

<div class="form-group">
<span class="question-label">Does the Athlete Currently Participate in Dryland?</span>
<div class="options">
<label class="option"><input type="radio" name="dryland" value="Yes consistently" required>Yes, consistently</label>
<label class="option"><input type="radio" name="dryland" value="Yes occasionally">Yes, occasionally</label>
<label class="option"><input type="radio" name="dryland" value="No">No</label>
</div>
</div>

<div class="form-group">
<span class="question-label">Does the Athlete Currently Participate in Strength Training / Lifting?</span>
<div class="options">
<label class="option"><input type="radio" name="strength_training" value="Yes consistently" required>Yes, consistently</label>
<label class="option"><input type="radio" name="strength_training" value="Yes occasionally">Yes, occasionally</label>
<label class="option"><input type="radio" name="strength_training" value="No">No</label>
</div>
</div>

<div class="form-group">
<label for="strengths">Greatest Athletic Strengths</label>
<span class="helper">Consider endurance, speed, relays, technique, underwaters, coachability, and versatility.</span>
<textarea id="strengths" name="athletic_strengths" required></textarea>
</div>

<div class="form-group">
<label for="coachRelationship">Relationship With Coaches</label>
<textarea id="coachRelationship" name="coach_relationship" required></textarea>
</div>

<div class="form-group">
<label for="injuries">Injury History</label>
<span class="helper">If applicable, describe previous injuries.</span>
<textarea id="injuries" name="injury_history" required></textarea>
</div>

<div class="form-group">
<label for="meets">Major Upcoming Meets</label>
<span class="helper">List significant meets during the next 6–12 months.</span>
<textarea id="meets" name="upcoming_meets" required></textarea>
</div>
</div>

<!-- SECTION 4 -->
<div class="form-card">
<div class="form-card-head">
<span class="eyebrow">Section 04</span>
<h2>Academic Profile</h2>
</div>

<div class="form-row">
<div class="form-group">
<label for="apClasses">AP Classes</label>
<input type="text" id="apClasses" name="ap_classes" placeholder="Taken / planning to take" required>
</div>
<div class="form-group">
<label for="honorsClasses">Honors Classes</label>
<input type="text" id="honorsClasses" name="honors_classes" placeholder="Taken / planning to take" required>
</div>
</div>

<div class="form-group">
<label for="tests">PSAT / ACT / SAT Score</label>
<input type="text" id="tests" name="test_scores" placeholder="Specify test, score, and number of attempts" required>
</div>

<div class="form-row">
<div class="form-group">
<label for="gpa">GPA</label>
<input type="text" id="gpa" name="gpa" placeholder="Weighted and/or unweighted, including scale" required>
</div>
<div class="form-group">
<label for="rank">Class Rank</label>
<input type="text" id="rank" name="class_rank" placeholder="If available" required>
</div>
</div>

<div class="form-group">
<label for="classSize">Class Size</label>
<input type="text" id="classSize" name="class_size" placeholder="If available" required>
</div>

<div class="form-group">
<label for="extracurriculars">Extracurricular Activities</label>
<span class="helper">Consider leadership, clubs, research, volunteering, and employment.</span>
<textarea id="extracurriculars" name="extracurriculars" required></textarea>
</div>
</div>

<!-- SECTION 5 -->
<div class="form-card">
<div class="form-card-head">
<span class="eyebrow">Section 05</span>
<h2>Current Recruiting Activity</h2>
</div>

<div class="form-group">
<span class="question-label">Current Recruiting Stage</span>
<div class="options">
<label class="option"><input type="radio" name="recruiting_stage" value="Have not started" required>Have not started</label>
<label class="option"><input type="radio" name="recruiting_stage" value="Started researching schools">Started researching schools</label>
<label class="option"><input type="radio" name="recruiting_stage" value="Created initial school list">Created initial school list</label>
<label class="option"><input type="radio" name="recruiting_stage" value="Contacting coaches">Athlete has begun contacting coaches</label>
<label class="option"><input type="radio" name="recruiting_stage" value="Completed coach calls">Athlete has completed coach calls</label>
</div>
</div>

<div class="form-group">
<label for="schoolsContacted">Schools Contacted / Interest Received</label>
<textarea id="schoolsContacted" name="schools_contacted" required></textarea>
</div>

<div class="form-group">
<label for="visits">College Visits</label>
<textarea id="visits" name="college_visits" placeholder="Official or unofficial visits, if applicable" required></textarea>
</div>
</div>

<!-- SECTION 6 -->
<div class="form-card">
<div class="form-card-head">
<span class="eyebrow">Section 06</span>
<h2>College Preferences</h2>
</div>

<div class="form-group">
<label for="topSchools">Current Top-Choice Schools</label>
<span class="helper">Please identify if athlete would be a legacy at a listed school</span>
<textarea id="topSchools" name="top_choice_schools" required></textarea>
</div>

<div class="form-group">
<label for="schoolPreferences">What Is the Athlete Looking for in a School?</label>
<span class="helper">Consider academics vs. athletics, social life, school size, campus setting, and other priorities.</span>
<textarea id="schoolPreferences" name="school_preferences" required></textarea>
</div>

<div class="form-group">
<span class="question-label">Athletic Divisions the Athlete Would Consider</span>
<div class="options checkbox-group" data-group="divisions">
<label class="option"><input type="checkbox" name="divisions[]" value="Division I" required>Division I</label>
<label class="option"><input type="checkbox" name="divisions[]" value="Division II">Division II</label>
<label class="option"><input type="checkbox" name="divisions[]" value="Division III">Division III</label>
</div>
</div>

<div class="form-group">
<span class="question-label">Conferences / Program Types of Interest</span>
<div class="options checkbox-group" data-group="conferences">
<label class="option"><input type="checkbox" name="conferences[]" value="Ivy League" required>Ivy League</label>
<label class="option"><input type="checkbox" name="conferences[]" value="NESCAC">NESCAC</label>
<label class="option"><input type="checkbox" name="conferences[]" value="Patriot League">Patriot League</label>
<label class="option"><input type="checkbox" name="conferences[]" value="UAA">UAA</label>
<label class="option"><input type="checkbox" name="conferences[]" value="SEC">SEC</label>
<label class="option"><input type="checkbox" name="conferences[]" value="Big 12">Big 12</label>
<label class="option"><input type="checkbox" name="conferences[]" value="ACC">ACC</label>
<label class="option"><input type="checkbox" name="conferences[]" value="Big Ten">Big Ten</label>
<label class="option"><input type="checkbox" name="conferences[]" value="America East">America East</label>
</div>
</div>

<div class="form-group">
<label for="otherConference">Other Conference / Program Type</label>
<input type="text" id="otherConference" name="other_conference">
</div>

<div class="form-group">
<span class="question-label">Regions the Athlete Would Consider</span>
<div class="options checkbox-group" data-group="regions">
<label class="option"><input type="checkbox" name="regions[]" value="New England" required>New England</label>
<label class="option"><input type="checkbox" name="regions[]" value="Mid-Atlantic">Mid-Atlantic</label>
<label class="option"><input type="checkbox" name="regions[]" value="Southeast">Southeast</label>
<label class="option"><input type="checkbox" name="regions[]" value="Midwest">Midwest</label>
<label class="option"><input type="checkbox" name="regions[]" value="Southwest">Southwest</label>
<label class="option"><input type="checkbox" name="regions[]" value="West Coast">West Coast</label>
<label class="option"><input type="checkbox" name="regions[]" value="International">International</label>
</div>
</div>

<div class="form-group">
<span class="question-label">How Important Is Athletic Scholarship Funding?</span>
<div class="options">
<label class="option"><input type="radio" name="scholarship_importance" value="Essential" required>Essential</label>
<label class="option"><input type="radio" name="scholarship_importance" value="Very important">Very important</label>
<label class="option"><input type="radio" name="scholarship_importance" value="Helpful but not required">Helpful but not required</label>
<label class="option"><input type="radio" name="scholarship_importance" value="Not important">Not important</label>
<label class="option"><input type="radio" name="scholarship_importance" value="Unsure">Unsure</label>
</div>
</div>

<div class="form-group">
<span class="question-label">Preference for Men's and Women's Teams Combined</span>
<div class="options">
<label class="option"><input type="radio" name="combined_team_preference" value="Yes combined" required>Combined</label>
<label class="option"><input type="radio" name="combined_team_preference" value="Yes not combined">Not combined</label>
<label class="option"><input type="radio" name="combined_team_preference" value="No preference">No preference / N/A</label>
</div>
</div>
</div>

<!-- SUBMIT -->
<div class="submit-card">
<h2>Ready to submit?</h2>
<p>Every question above must be answered before you can continue. Once submitted, your questionnaire will be sent securely to Signing Day Advisors and you will be taken to the Terms and Conditions.</p>
<button class="btn-gold" type="submit">Proceed to Terms and Conditions</button>
<div class="form-status" id="form-status">Thank you. Your questionnaire has been submitted.</div>
</div>

</form>
</div>
</section>

</Base>

<style is:global>
/* nav */
nav{position:sticky;top:0;z-index:50;background:rgba(15,42,74,.96);backdrop-filter:blur(8px);border-bottom:1px solid rgba(201,161,59,.25)}

/* hero */
.hero{background:var(--navy);color:#fff;padding:90px 0 76px}
.hero .eyebrow{display:block;margin-bottom:20px}
.hero h1{font-size:clamp(40px,6vw,60px);max-width:760px;margin-bottom:22px}
.hero h1 em{font-style:normal;color:var(--gold-soft)}
.hero p{font-size:17px;color:#C7D2DE;max-width:680px}

/* progress */
.progress{background:#fff;border-bottom:1px solid var(--line)}
.progress-grid{display:grid;grid-template-columns:repeat(4,1fr)}
.progress-step{padding:20px 16px;border-right:1px solid var(--line)}
.progress-step:last-child{border-right:none}
.progress-step.current{background:#FFFCF5}
.progress-num{display:block;font-family:'IBM Plex Mono',monospace;font-size:10px;color:var(--gold);margin-bottom:4px}
.progress-step strong{font-size:12.5px;color:var(--navy)}

/* intro */
.intro{padding:64px 0 34px}
.intro-card{background:#fff;border:1px solid var(--line);border-radius:8px;padding:34px 38px;position:relative;overflow:hidden}
.intro-card::before{content:"";position:absolute;left:0;top:0;bottom:0;width:4px;background:var(--gold)}
.intro-card .eyebrow{display:block;margin-bottom:12px}
.intro-card h2{font-size:30px;color:var(--navy);margin-bottom:14px}
.intro-card p{font-size:15px;color:var(--muted);margin-bottom:12px}
.prep{list-style:none;margin-top:18px}
.prep li{padding:8px 0;border-bottom:1px solid var(--line);font-size:14px}
.prep li::before{content:"—";color:var(--gold);margin-right:10px}

/* form */
.form-section{padding:26px 0 90px}
.questionnaire{display:flex;flex-direction:column;gap:24px}
.form-card{background:#fff;border:1px solid var(--line);border-radius:8px;padding:36px 38px}
.form-card-head{margin-bottom:28px;padding-bottom:20px;border-bottom:1px solid var(--line)}
.form-card-head .eyebrow{display:block;margin-bottom:8px}
.form-card-head h2{font-size:28px;color:var(--navy)}
.form-row{display:grid;grid-template-columns:1fr 1fr;gap:20px}
.form-group{display:flex;flex-direction:column;gap:8px;margin-bottom:20px}
.form-group:last-child{margin-bottom:0}
.form-group label,.question-label{font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:1px;text-transform:uppercase;color:var(--navy);font-weight:500}
.helper{font-size:12.5px;color:var(--muted);margin-top:-2px}
.form-group input,.form-group select,.form-group textarea{font-family:'Newsreader',serif;font-size:15px;color:var(--ink);background:var(--cream);border:1px solid var(--line);border-radius:2px;padding:13px 14px;width:100%}
.form-group input:focus,.form-group select:focus,.form-group textarea:focus{outline:none;border-color:var(--gold);background:#fff}
.form-group textarea{resize:vertical;min-height:110px}
.options{display:flex;flex-wrap:wrap;gap:10px;margin-top:3px}
.option{display:inline-flex;align-items:center;justify-content:flex-start;gap:8px;background:var(--cream);border:1px solid var(--line);padding:9px 12px;border-radius:3px;font-size:13.5px;line-height:1.2;cursor:pointer;width:auto}
.option input{width:auto!important;margin:0!important;flex:0 0 auto}
.submit-card{background:var(--navy);border-radius:8px;padding:38px;color:#fff}
.submit-card h2{font-size:30px;margin-bottom:12px}
.submit-card p{font-size:14px;color:#A9B7C6;max-width:620px}
.btn-gold{background:var(--gold);color:var(--navy);padding:15px 28px;border:0;border-radius:2px;font-family:'Newsreader',serif;font-size:14px;font-weight:600;cursor:pointer;margin-top:24px}
.btn-gold:hover{background:var(--gold-soft)}
.form-status{display:none;margin-top:18px;font-size:14px;color:var(--gold-soft)}
.form-status.show{display:block}

/* footer */
footer{background:var(--navy-deep);padding:40px 0;color:#718296}
footer p{font-size:12px}

@media(max-width:760px){
  .progress-grid{grid-template-columns:repeat(2,1fr)}
  .form-row{grid-template-columns:1fr}
  .form-card{padding:28px 24px}
  .intro-card{padding:28px 24px}
}
</style>

<script is:inline>
const form=document.getElementById('questionnaire-form');
const status=document.getElementById('form-status');

document.querySelectorAll('.checkbox-group').forEach(function(group){
  const boxes=group.querySelectorAll('input[type="checkbox"]');
  function sync(){
    const anyChecked=Array.from(boxes).some(function(b){return b.checked});
    boxes.forEach(function(b){b.required=!anyChecked});
  }
  boxes.forEach(function(b){b.addEventListener('change',sync)});
  sync();
});

form.addEventListener('submit',async function(e){
  e.preventDefault();

  const button=form.querySelector('button[type="submit"]');
  button.disabled=true;
  button.textContent='Submitting...';

  try{
    const response=await fetch(form.action,{
      method:'POST',
      body:new FormData(form),
      headers:{Accept:'application/json'}
    });

    if(response.ok){
      button.textContent='Submitted';
      status.textContent='Thank you. Your questionnaire has been submitted. Redirecting you to the Terms and Conditions...';
      status.classList.add('show');

      setTimeout(()=>{
        window.location.href='../terms/';
      },1200);

    }else{
      button.disabled=false;
      button.textContent='Proceed to Terms and Conditions';
      alert('There was a problem submitting the questionnaire. Please try again.');
    }

  }catch(error){
    button.disabled=false;
    button.textContent='Submit Questionnaire';
    alert('There was a problem submitting the questionnaire. Please try again.');
  }
});
</script>
