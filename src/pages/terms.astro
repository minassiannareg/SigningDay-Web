<style is:global>
.page-header{background:#fff;border-bottom:1px solid var(--line);padding:52px 0 42px}
.page-header .eyebrow{display:block;margin-bottom:12px}
.page-header h1{font-family:'Fraunces',serif;font-weight:500;color:var(--navy);font-size:clamp(36px,5vw,48px);line-height:1.1;margin-bottom:10px}
.effective{font-size:12px;color:var(--muted)}
.terms-section{padding:52px 0 80px}
.terms-document{background:#fff;border:1px solid var(--line);border-radius:6px;padding:48px 52px}
.terms-intro{font-size:13px;color:var(--ink);margin-bottom:30px}
.terms-block{margin-bottom:30px}
.terms-block:last-child{margin-bottom:0}
.terms-block h2{font-family:'Newsreader',serif;font-size:14px;font-weight:600;color:var(--navy);margin-bottom:8px}
.terms-block p,.terms-block li{font-size:12.5px;line-height:1.65;color:#424A51}
.terms-block p+p{margin-top:8px}
.terms-block ul{margin:8px 0 0 20px}
.terms-block li{margin-bottom:5px}
.legal-note{margin-top:34px;padding-top:22px;border-top:1px solid var(--line);font-size:11.5px;color:var(--muted)}
.acceptance{margin-top:34px;padding-top:30px;border-top:1px solid var(--line)}
.acceptance h2{font-family:'Fraunces',serif;color:var(--navy);font-size:24px;margin-bottom:8px}
.acceptance p{font-size:12.5px;color:var(--muted);margin-bottom:24px}
.actions{display:flex;gap:14px;flex-wrap:wrap}
.btn-accept,.btn-decline{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:13px 22px;border-radius:2px;font-family:'Newsreader',serif;font-size:14px;font-weight:600;cursor:pointer;transition:all .2s}
.btn-accept{background:var(--gold);color:var(--navy);border:1px solid var(--gold)}
.btn-accept:hover{background:var(--gold-soft);border-color:var(--gold-soft)}
.btn-decline{background:#fff;color:var(--muted);border:1px solid var(--line)}
.btn-decline:hover{border-color:#A8A39A;color:var(--ink)}
footer p{font-size:12px}
@media(max-width:760px){.terms-document{padding:32px 24px}.nav-toggle{display:block}.nav-links a{padding:14px 0;border-bottom:1px solid rgba(255,255,255,.08)}.actions{flex-direction:column}.btn-accept,.btn-decline{width:100%}}
</style>

<script is:inline>
  var agreeButton = document.getElementById('agreeButton');
  var stripePayment = document.getElementById('stripePayment');
  if (agreeButton && stripePayment) {
    agreeButton.addEventListener('click', function () {
      stripePayment.style.display = 'block';
      agreeButton.style.display = 'none';
      stripePayment.scrollIntoView({ behavior: 'smooth', block: 'center' });
    });
  }
</script>
