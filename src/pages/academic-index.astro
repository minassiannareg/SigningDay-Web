      <div class="category-chip">
        <div class="ic-sm"><svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg"><circle cx="22" cy="9" r="2.6" fill="#0F2A4A"/><path d="M6 18 L13 15 L18 18 L24 15.5" stroke="#0F2A4A" stroke-width="1.5" fill="none" stroke-linecap="round"/><path d="M5 22 q3 -3 6 0 q3 3 6 0 q3 -3 6 0 q3 3 6 0" stroke="#C9A13B" stroke-width="1.4" fill="none"/></svg></div>
