        <h4>Compare</h4>
        <p>Statistical comparison</p>
      </div>
      <div class="pipeline-arrow">&rarr;</div>
      <div class="pipeline-stage">
        <div class="pipeline-num"><svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg"><line x1="16" y1="6" x2="16" y2="15" stroke="#0F2A4A" stroke-width="1.6" stroke-linecap="round"/><line x1="16" y1="15" x2="9" y2="26" stroke="#0F2A4A" stroke-width="1.6" stroke-linecap="round"/><line x1="16" y1="15" x2="23" y2="26" stroke="#0F2A4A" stroke-width="1.6" stroke-linecap="round"/><circle cx="9" cy="26" r="2.4" fill="#C9A13B"/><circle cx="23" cy="26" r="2.4" fill="#C9A13B"/></svg></div>
        <h4>Two outputs</h4>
        <p>Two distinct results</p>
      </div>
