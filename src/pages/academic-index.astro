<script is:inline>
requestAnimationFrame(function(){requestAnimationFrame(function(){
  var h=document.querySelector('.hero'); if(h) h.classList.add('lit');
})});
</script>

<script define:vars={{ model }}>
  // One model, mirrored from the Python. Constants arrive in `model`,
  // generated by export_web_model.py — change the Python, re-run the export.
  //
  // This page shows the real 60-240 Academic Index only
  // (Recruiting_Academic_Index.py), computed with the test score and without
  // it. Our holistic 1-10 read used to sit under it as a secondary line; it
  // was removed from the public page on 2026-09-02 because a second, differently
  // scaled score invited visitors to read it as a second verdict. It is still
  // computed for real clients — see Academic_Index.py and Generate_Client_Report.py.
  (function () {
    var form = document.getElementById('ai-form');
    if (!form) return;

    var gpaEl  = document.getElementById('f-gpa');
    var testEl = document.getElementById('f-test');
    var schoolEl = document.getElementById('f-school');
    var mode   = 'sat';

    var AI = model.ai;

    function piecewise(v, anchors) {
      if (v <= anchors[0][0]) return anchors[0][1];
      if (v >= anchors[anchors.length - 1][0]) return anchors[anchors.length - 1][1];
      for (var i = 0; i < anchors.length - 1; i++) {
        var a = anchors[i], b = anchors[i + 1];
        if (v >= a[0] && v <= b[0]) return a[1] + (v - a[0]) / (b[0] - a[0]) * (b[1] - a[1]);
      }
      return anchors[anchors.length - 1][1];
    }

    function clampAI(v) { return Math.max(AI.min, Math.min(AI.max, v)); }

    function bandFor(score) {
      for (var i = 0; i < AI.bands.length; i++) {
        if (score >= AI.bands[i][0]) return AI.bands[i][1];
      }
      return AI.bands[AI.bands.length - 1][1];
    }

    // The same six bands said plainly, keyed on each band's own cutoff rather
    // than its wording, so it stays pinned to academic-model.json. The exact
    // label from the report still shows underneath - this only adds a sentence
    // a ninth grader can read without a glossary. A cutoff with no entry here
    // simply shows no plain line, which is why the lookup can miss safely.
    var BAND_PLAIN = {
      230: 'Top of the scale. Strong enough for the most selective Ivies.',
      220: 'Very strong anywhere in the Ivy League.',
      210: 'Right in the range these schools usually admit.',
      200: 'Solid. Coaches can work with this.',
      176: 'At the low end coaches can support. It depends on the school and sport.',
      0:   'Below the usual recruiting range for these schools.'
    };

    function bandPlainFor(score) {
      for (var i = 0; i < AI.bands.length; i++) {
        if (score >= AI.bands[i][0]) return BAND_PLAIN[AI.bands[i][0]] || '';
      }
      return '';
    }

    // ---- official published percentiles (Test_Percentiles.py) ----
    // A sourced fact about the score, shown next to the modelled numbers. It
    // describes where the score sits among test takers; it does not feed any
    // score on this page.
    var TP = model.testPercentiles;

    function pctLabel(p) {
      if (p === null || p === undefined) return null;
      if (p >= TP.top) return '99+';
      if (p < 1) return 'below the 1st';
      var n = Math.round(p), r100 = n % 100, r10 = n % 10;
      var suf = (r100 >= 11 && r100 <= 13) ? 'th'
              : r10 === 1 ? 'st' : r10 === 2 ? 'nd' : r10 === 3 ? 'rd' : 'th';
      return n + suf;
    }

    function satPercentile(sat) {
      if (sat === null || sat === undefined) return null;
      var s = Math.max(400, Math.min(1600, Math.round(sat)));
      s -= s % 10;
      var v = TP.sat[String(s)];
      return v === undefined ? null : v;
    }

    function actPercentile(act) {
      var v = TP.act[String(Math.max(1, Math.min(36, Math.round(act))))];
      return v === undefined ? null : v;
    }

    // ---- the school-relative submit/withhold rule ----
    // A direct port of test_submission_recommendation() in
    // Recruiting_Academic_Index.py. Same thresholds, same normal
    // reconstruction from a school's published 25th/75th, same reference
    // population — the school's own submitted scores. This is the ONLY thing
    // on the page that answers "should I send it," because it is the only
    // thing on the page that knows where "it" is going.
    var SR = model.schoolRelative;
    var SCHOOLS = {};
    (model.schools || []).forEach(function (sc) { SCHOOLS[sc.name] = sc; });

    // Abramowitz & Stegun 7.1.26 — stands in for Python's math.erf, which the
    // browser has no equivalent of. Accurate to ~1.5e-7, far inside the
    // precision of a percentile reconstructed from two published numbers.
    function erf(x) {
      var sign = x < 0 ? -1 : 1, ax = Math.abs(x);
      var t = 1 / (1 + 0.3275911 * ax);
      var y = 1 - ((((1.061405429 * t - 1.453152027) * t + 1.421413741) * t
                    - 0.284496736) * t + 0.254829592) * t * Math.exp(-ax * ax);
      return sign * y;
    }

    function schoolPercentile(sat, sc) {
      if (sat === null || !sc || !(sc.sat75 > sc.sat25)) return null;
      var sd   = (sc.sat75 - sc.sat25) / SR.iqrToSd;
      var mean = (sc.satAvg === null || sc.satAvg === undefined)
               ? (sc.sat25 + sc.sat75) / 2 : sc.satAvg;
      return 0.5 * (1 + erf(((sat - mean) / sd) / Math.SQRT2)) * 100;
    }

    // The three verdict marks. Their own element, never inside .ts-chip: the
    // parity harness reads that chip's textContent and must keep seeing the
    // label and nothing else.
    var ICONS = {
      yes:   '<svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" '
           + 'stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">'
           + '<path d="M3 8.4 L6.4 11.8 L13 4.4"/></svg>',
      maybe: '<svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" '
           + 'stroke-width="1.7" stroke-linecap="round">'
           + '<circle cx="8" cy="8" r="5.7"/><path d="M5.4 8 H10.6"/></svg>',
      no:    '<svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" '
           + 'stroke-width="1.9" stroke-linecap="round">'
           + '<path d="M4.4 4.4 L11.6 11.6 M11.6 4.4 L4.4 11.6"/></svg>',
      '':    ''
    };

    // A picture of one fact: the school's published middle 50%, and where this
    // score sits inside it. Domain is 800-1600, the SAT slider's own range, so
    // the bar and the slider above it read on the same scale.
    //
    // The national benchmark draws on exactly the same bar. Its band is the
    // 25th-to-75th of the College Board's published table instead of one
    // school's Common Data Set, and its sentence counts test takers instead of
    // applicants, because nobody sends a score to the country.
    function rangeBar(sat, sc, at) {
      var lo = 800, hi = 1600;
      var pos = function (v) { return Math.max(0, Math.min(100, (v - lo) / (hi - lo) * 100)); };
      var a = pos(sc.sat25), b = pos(sc.sat75), y = pos(sat);
      var side = y < 12 ? ' lo' : y > 88 ? ' hi' : '';
      var n = Math.round(at);
      var f = sc.national
            ? (n < 1  ? 'Lower than almost every score in the country.'
             : n > 99 ? 'Higher than almost every score in the country.'
             : 'Higher than ' + n + '% of test takers nationally.')
            : (n < 1  ? 'Lower than almost every score sent to ' + sc.name + '.'
             : n > 99 ? 'Higher than almost every score sent to ' + sc.name + '.'
             : 'Higher than ' + n + '% of the scores sent to ' + sc.name + '.');
      return '<span class="rb-h">' + sc.name + ' &middot; middle 50% ' +
               sc.sat25 + '&ndash;' + sc.sat75 + '</span>' +
             '<span class="rb">' +
               '<i class="rb-band" style="left:' + a.toFixed(1) + '%;width:' +
                 Math.max(1, b - a).toFixed(1) + '%"></i>' +
               '<b class="rb-tag' + side + '" style="left:' + y.toFixed(1) + '%">you ' +
                 sat + '</b>' +
               '<i class="rb-you" style="left:' + y.toFixed(1) + '%"></i>' +
             '</span>' +
             '<span class="rb-ends"><span>800</span><span>1600</span></span>' +
             '<span class="rb-f">' + f + '</span>';
    }

    // Returns {klass, chip, range, why, caveat, conflict}. Mirrors the four
    // verdict branches in the Python, condensed for a panel rather than a
    // report page.
    function submissionCall(sat, aiIncl, aiExcl) {
      var sc = SCHOOLS[schoolEl.value];
      if (!sc) {
        return {
          klass: '', chip: 'Choose a school', range: '',
          why: 'The same score can be a strength at one school and a weakness at another. ' +
               'A 1300 beats 85% of test takers nationally, and still sits below what ' +
               'Bowdoin enrolls. Pick a school for a real answer, or the national ' +
               'average to see where the score sits overall.',
          caveat: '', conflict: false
        };
      }
      if (sat === null) {
        return {
          klass: '', chip: sc.national ? 'No test score to place' : 'No test score to send',
          range: '',
          why: sc.national
             ? 'You have not entered a test score, so there is nothing to put on the ' +
               'national scale. The number above is the no-score version.'
             : 'You have not entered a test score, so there is nothing to send. ' +
               sc.name + ' would read the rest of your application instead. The number ' +
               'above is the no-score version.',
          caveat: '', conflict: false
        };
      }

      // One ladder, two vocabularies. The thresholds, the branch order and the
      // three verdict classes are identical for a school and for the national
      // benchmark - only the words change, because "submit" is a question you
      // can only ask of a school.
      //
      // The benchmark reads its percentile straight off the published table
      // rather than off the normal reconstruction. That is the number the gold
      // line above already shows, in the College Board's own words, and two
      // different national percentiles an inch apart would be a visible
      // contradiction. Reconstruction is what you do when the distribution is
      // unpublished; here it is published.
      var at = sc.national ? satPercentile(sat) : schoolPercentile(sat, sc);
      if (at === null) at = schoolPercentile(sat, sc);

      // A school branch quotes the SAT-equivalent, because a school's
      // published range is an SAT range and the two have to be on one scale.
      // Against the national tables the student's own ACT is the number they
      // recognise from their score report, so name both rather than showing
      // them a score they never sat.
      var you = (sc.national && mode === 'act')
              ? 'ACT ' + parseInt(testEl.value, 10) + ' (about ' + sat + ' on the SAT scale)'
              : sat;
      // Same two published numbers and the same computed position as before,
      // drawn instead of described. The national percentile is deliberately
      // not repeated in this block - it is already on the page in #v-pct, in
      // the College Board's own words, and saying it twice was most of the
      // length here.
      var out = { range: rangeBar(sat, sc, at), conflict: false, caveat: '' };

      if (at >= SR.strongPercentile) {
        out.klass = 'yes';
        out.chip = sc.national ? 'Top quarter nationally' : 'Submit — a clear strength';
        out.why = sc.national
                ? 'Your ' + you + ' is in the top quarter of test takers nationally. ' +
                  'That is a strong score. Pick a school above to see whether it is a ' +
                  'strong one there too.'
                : 'Your ' + sat + ' is in the top quarter of the scores ' + sc.name +
                  ' enrolls. It is strong where it counts — against this one ' +
                  'school\u2019s own range, not against the country.';
      } else if (at >= SR.submitPercentile) {
        out.klass = 'yes';
        out.chip = sc.national ? 'Above the national middle' : 'Submit';
        out.why = sc.national
                ? 'Your ' + you + ' is above the middle of test takers nationally. ' +
                  'A solid score. The schools on this page draw from a much smaller, ' +
                  'higher-scoring group, so check one of those too.'
                : 'Your ' + sat + ' is at or above the middle of the scores ' + sc.name +
                  ' enrolls. Sending it backs up the rest of your application instead of ' +
                  'raising a question.';
      } else if (at >= SR.withholdPercentile) {
        out.klass = 'maybe';
        out.chip = sc.national ? 'In the national middle' : 'Judgment call';
        out.why = sc.national
                ? 'Your ' + you + ' is inside the national middle 50%, in the lower half ' +
                  'of it. That is an ordinary score nationally, and a light one for the ' +
                  'schools on this page.'
                : 'Your ' + sat + ' is inside ' + sc.name + '\u2019s middle 50%, but in the ' +
                  'lower half of it. A score here will not carry your application and will ' +
                  'not sink it. Ask the coach what a pre-read needs.';
      } else if (sc.pctSubmitting !== null && sc.pctSubmitting !== undefined &&
                 sc.pctSubmitting >= SR.effectivelyRequiredSharePct) {
        // Test-optional on paper, test-submitting in practice. A withhold here
        // is advice the student cannot act on cleanly — leaving the field
        // blank where everyone else has a number is itself conspicuous.
        out.klass = 'maybe'; out.chip = 'Judgment call';
        out.why = 'Your ' + sat + ' is below ' + sc.name + '\u2019s bottom quarter, so on its ' +
                  'own it does not help. But ' + Math.round(sc.pctSubmitting) + '% of students ' +
                  'there send a score, so a blank space stands out. Either way, your score is ' +
                  'light for this school.';
      } else {
        out.klass = 'no';
        out.chip = sc.national ? 'Below the national middle' : 'Do not submit';
        out.why = sc.national
                ? 'Your ' + you + ' is below the national middle 50%, which starts at ' +
                  sc.sat25 + '. Three quarters of test takers scored higher. There is room ' +
                  'to move here, and a retake usually moves it.'
                : 'Your ' + sat + ' is below ' + sc.name + '\u2019s bottom quarter of ' +
                  sc.sat25 + '. It may be a good score nationally, but it is a weak one here. ' +
                  sc.name + ' is test-optional, so you do not have to send it.';

        // Where the two channels disagree, say so rather than hiding one.
        // Round to one decimal before comparing, exactly as the Python does:
        // compute_academic_index() rounds both AIs into its result dict and
        // test_submission_recommendation() subtracts the rounded pair. Without
        // this the two sides disagree on scores that land on the margin.
        var r1 = function (v) { return Math.round(v * 10) / 10; };
        var delta = aiIncl === null ? 0 : r1(r1(aiIncl) - r1(aiExcl));
        if (delta > AI.recommendationMargin) {
          out.conflict = true;
          out.why += '\n\nOne thing a coach may bring up: sending your score does raise ' +
                     'your Academic Index, from ' + Math.round(aiExcl) + ' to ' +
                     Math.round(aiIncl) + '. It helps you more with a coach than with an ' +
                     'admissions reader. The coach decides that one.';
        }
      }

      if (sc.national) {
        // The bar is on the SAT scale, so the ACT band gets its own sentence
        // rather than a second number on the same axis: ACT ranks a broader
        // population than the SAT user group, and the two 25th-to-75th bands
        // are not conversions of each other.
        out.caveat = 'On ACT\u2019s own table the middle 50% is ' + sc.act25 + '\u2013' +
                     sc.act75 + '. SAT percentiles are the College Board\u2019s own ' +
                     'published table for ' + sc.population + '.' +
                     (mode === 'act'
                      ? ' Your ACT is converted to the SAT scale first, so this can sit a ' +
                        'few points off the ACT rank above: the two tests are ranked ' +
                        'against different groups of students.'
                      : '');
      } else if (sc.pctSubmitting !== null && sc.pctSubmitting !== undefined &&
          sc.pctSubmitting < SR.thinSubmissionSharePct) {
        out.caveat = 'Only ' + Math.round(sc.pctSubmitting) + '% of ' + sc.name +
                     '\u2019s class sent a score, so the bar above covers only students who ' +
                     'chose to send one — mostly high scorers. ' + sc.dataYear + ' figures.';
      } else {
        out.caveat = sc.dataYear + ' figures. Your spot on the bar is worked out from the ' +
                     'school\u2019s published 25th and 75th percentiles, so it is close but ' +
                     'not exact.';
      }
      return out;
    }

    var ARC = Math.PI * 90; // semicircle, r=90 — matches the dial path

    function update() {
      var gpa = parseFloat(gpaEl.value);

      var sat = null;
      if (mode === 'sat') sat = parseInt(testEl.value, 10);
      else if (mode === 'act') sat = model.actToSat[String(parseInt(testEl.value, 10))];

      // ---- 1. the Academic Index (60-240) ----
      var cgs = piecewise(gpa, AI.gpaToCgs);                       // 20-80
      var testPoints = sat === null ? null : sat / 10;             // 40-160
      var imputed = piecewise(gpa, AI.gpaToTypicalTestPoints) * AI.uncertaintyDiscount;

      var aiExclusive = clampAI(cgs + imputed);
      var aiInclusive = testPoints === null ? null : clampAI(testPoints + cgs);

      // Which AI is higher is arithmetic, and we report it as such. Whether to
      // SEND the score is a different question with a different answer, and it
      // is answered in its own block below, against one school's own range —
      // never here. Mirrors the 2026-09-01 revision in
      // Recruiting_Academic_Index.py — keep the two in step.
      //
      // FOUR states, not three. The margin band — where the no-score Academic
      // Index is higher but by less than the margin — is its own case. We still
      // lead with the number built on the real score there (the margin exists
      // because the no-score number is an ESTIMATE, and a sub-margin edge to an
      // estimate is not evidence), but that means the headline is NOT the
      // higher of the two, and a chip claiming it is, is false. Folding this
      // case into the final `else` is what produced the 2026-09-02 bug: a
      // 4.0/1220 read 202 beside "without it 206" under "this score raises
      // your AI". Mirrors compute_academic_index() — keep the two in step.
      var margin = Math.round(AI.recommendationMargin);
      var recommended, chip, why;
      if (aiInclusive === null) {
        recommended = aiExclusive;
        chip = 'No test score entered';
        why  = 'You have not entered a test score, so we estimated one from your GPA. We then ' +
               'lower that estimate a little, because a guess should never count as much as a ' +
               'real score.';
      } else if (aiExclusive - aiInclusive > AI.recommendationMargin) {
        recommended = aiExclusive;
        chip = 'Your grades alone score higher';
        why  = 'Leaving your test score out gives you a higher Academic Index. That is worth ' +
               'knowing, but it does not mean you should hide the score. Whether to send it ' +
               'depends on the school, which we answer below.';
      } else if (aiInclusive > aiExclusive) {
        recommended = aiInclusive;
        chip = 'Your test score raises your Academic Index';
        why  = 'Adding your test score gives the higher number. That is only math. It does not ' +
               'mean your score is strong. Whether to send it is decided school by school, and ' +
               'we answer that below.';
      } else {
        // Ties land here too, and belong here: with the two equal, neither is
        // higher, and we still lead with the real score over the estimate.
        recommended = aiInclusive;
        chip = 'Almost no difference either way';
        why  = 'The two numbers are within ' + margin + ' points of each other. The no-score ' +
               'version is only an estimate, so a gap that small tells you nothing. We show the ' +
               'number built on your real score.';
      }

      var shown = Math.round(recommended * 10) / 10;

      // ---- paint ----
      document.getElementById('v-gpa').textContent  = gpa.toFixed(2);
      document.getElementById('v-test').textContent = mode === 'none' ? '—' : testEl.value;

      document.getElementById('g-num').textContent  = shown.toFixed(0);
      document.getElementById('g-read').textContent = bandFor(recommended);
      var gPlain = document.getElementById('g-plain');
      if (gPlain) gPlain.textContent = bandPlainFor(recommended);
      var caScore = document.getElementById('ca-score');
      if (caScore) caScore.textContent = shown.toFixed(0);

      document.getElementById('v-chip').textContent = chip;
      document.getElementById('v-why').textContent  = why;

      // The sourced line: what the test maker itself says about this score.
      // ACT gets its own published rank as well, because that is the number
      // printed on the student's score report and it sits a few points off the
      // SAT-concordant one (different test-taking populations).
      var pctEl = document.getElementById('v-pct');
      if (sat === null) {
        pctEl.innerHTML = '';   // clear the same property we set below
      } else {
        var line, who;
        if (mode === 'act') {
          var raw = parseInt(testEl.value, 10);
          line = 'ACT ' + raw + ' · ' + pctLabel(actPercentile(raw)) + ' percentile';
          who  = 'ACT-tested graduates, ACT’s published national ranks';
        } else {
          line = 'SAT ' + sat + ' · ' + pctLabel(satPercentile(sat)) + ' percentile';
          who  = TP.populationLabel;
        }
        pctEl.innerHTML = line + ' <span>— ' + who + '</span>';
      }
      // ---- the school-relative call ----
      // Note which national percentile feeds it: always the SAT-equivalent
      // one, even in ACT mode, because the school's published range is an SAT
      // range and the two have to be on one scale. The gold line above still
      // shows ACT's own published rank, which is what a student sees on their
      // own score report. Same split as score_context() in Test_Percentiles.py.
      var call = submissionCall(sat, aiInclusive, aiExclusive);
      // The benchmark is not a school, so the panel is not answering the
      // send-or-withhold question there. Say which question it IS answering.
      var tsLabel = document.getElementById('ts-label');
      if (tsLabel) {
        var picked = SCHOOLS[schoolEl.value];
        tsLabel.textContent = (picked && picked.national)
          ? 'Where does your score stand?'
          : 'Should you send your test score?';
      }
      var tsChip = document.getElementById('ts-chip');
      tsChip.textContent = call.chip;
      tsChip.className = 'ts-chip' + (call.klass ? ' ' + call.klass : '');
      var tsIco = document.getElementById('ts-ico');
      if (tsIco) {
        tsIco.innerHTML = ICONS[call.klass] || '';
        tsIco.className = 'ts-ico' + (call.klass ? ' ' + call.klass : '');
      }
      document.getElementById('ts-flag').hidden = !call.conflict;
      document.getElementById('ts-range').innerHTML = call.range;
      document.getElementById('ts-why').textContent = call.why;
      document.getElementById('ts-caveat').textContent = call.caveat;

      document.getElementById('v-incl').textContent =
        aiInclusive === null ? '—' : Math.round(aiInclusive);
      document.getElementById('v-excl').textContent = Math.round(aiExclusive);
      document.getElementById('v-pair').classList.toggle('no-test', aiInclusive === null);
      document.getElementById('v-chip').classList.toggle('alt', recommended === aiExclusive);

      var frac = (recommended - AI.min) / (AI.max - AI.min);
      var fill = document.getElementById('g-fill');
      fill.style.strokeDasharray  = ARC + ' ' + ARC;
      fill.style.strokeDashoffset = String(ARC * (1 - frac));

      // The two AI components, each as a share of its own ceiling.
      var shownTest = testPoints === null ? imputed : testPoints;
      document.getElementById('bl-test').textContent =
        testPoints === null ? 'Test score (estimated)' : 'Test score converted';
      var barVals = { gpa: [cgs, 80], test: [shownTest, 160] };
      Array.prototype.forEach.call(document.querySelectorAll('.bar-row'), function (row) {
        var pair = barVals[row.getAttribute('data-k')];
        row.querySelector('.bar-t i').style.width = (pair[0] / pair[1] * 100).toFixed(1) + '%';
        row.querySelector('.bar-v').textContent = Math.round(pair[0]) + '/' + pair[1];
        row.classList.toggle('est', row.getAttribute('data-k') === 'test' && testPoints === null);
      });

    }

    Array.prototype.forEach.call(document.querySelectorAll('.seg-b'), function (btn) {
      btn.addEventListener('click', function () {
        mode = btn.getAttribute('data-test');

        Array.prototype.forEach.call(document.querySelectorAll('.seg-b'), function (b) {
          var on = b === btn;
          b.classList.toggle('on', on);
          b.setAttribute('aria-pressed', on ? 'true' : 'false');
        });

        var label = document.getElementById('l-test');
        var ends  = document.getElementById('e-test');
        var wrap  = testEl.closest('.field');

        if (mode === 'none') {
          wrap.classList.add('off');
          testEl.disabled = true;
          label.textContent = 'Test score';
        } else {
          wrap.classList.remove('off');
          testEl.disabled = false;
          if (mode === 'sat') {
            label.textContent = 'SAT total';
            testEl.min = model.satRange[0]; testEl.max = model.satRange[1];
            testEl.step = 10; testEl.value = 1300;
            ends.innerHTML = '<span>' + model.satRange[0] + '</span><span>' + model.satRange[1] + '</span>';
          } else {
            label.textContent = 'ACT composite';
            testEl.min = model.actRange[0]; testEl.max = model.actRange[1];
            testEl.step = 1; testEl.value = 28;
            ends.innerHTML = '<span>' + model.actRange[0] + '</span><span>' + model.actRange[1] + '</span>';
          }
        }
        update();
      });
    });

    form.addEventListener('input', update);
    update();
  })();
</script>
