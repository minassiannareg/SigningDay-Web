  .tcard p{font-size:15px;color:var(--muted);max-width:250px;margin:0 auto}
  @media(max-width:720px){.three{grid-template-columns:1fr;gap:18px}}

  .role{margin-top:14px;display:inline-block;font-family:'IBM Plex Mono',monospace;font-size:10.5px;letter-spacing:1px;text-transform:uppercase;color:var(--navy);background:rgba(201,161,59,0.16);border:1px solid rgba(201,161,59,0.45);border-radius:2px;padding:3px 10px}
  .role.role-soft{color:var(--muted);background:rgba(108,106,99,0.10);border:1px solid rgba(108,106,99,0.28)}

  .rule-divider{display:flex;align-items:center;gap:16px;max-width:480px;margin:56px auto 34px;color:var(--muted);font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:2px;text-transform:uppercase}
  .rule-divider::before,.rule-divider::after{content:"";flex:1;height:1px;background:var(--line)}

  /* ---------------- GATE PANEL ---------------- */
  .gate-panel{background:linear-gradient(150deg,var(--navy),var(--navy-deep));border-radius:20px;padding:54px 50px 50px;position:relative;overflow:hidden}
  .gate-panel::before{content:"";position:absolute;top:-30%;left:50%;transform:translateX(-50%);width:520px;height:520px;background:radial-gradient(circle,rgba(201,161,59,0.14),transparent 62%);pointer-events:none}
  .gate-panel>*{position:relative;z-index:2}
  .gate-headline{font-size:clamp(24px,3.2vw,32px);color:#fff;text-align:center;max-width:560px;margin:0 auto 36px;letter-spacing:-0.6px}
  .gate{display:grid;grid-template-columns:1fr 1fr;gap:24px;max-width:760px;margin:0 auto}
  .gate-card{background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.14);border-radius:14px;padding:36px 28px;text-align:center;transition:transform .3s,background .3s,border-color .3s}
  .gate-card:hover{transform:translateY(-5px);background:rgba(255,255,255,0.08);border-color:rgba(201,161,59,0.5)}
  .gate-ic{width:64px;height:64px;border-radius:50%;background:rgba(201,161,59,0.15);border:1px solid rgba(201,161,59,0.5);display:flex;align-items:center;justify-content:center;margin:0 auto 18px;transition:all .3s}
  .gate-card:hover .gate-ic{background:rgba(201,161,59,0.28);transform:scale(1.08)}
  .gate-ic svg{width:32px;height:32px}
  .gate-card h3{font-size:19px;color:#fff;margin-bottom:8px}
  .gate-card p{font-size:15px;color:#A9B7C6}
  .gate-rule{max-width:600px;margin:36px auto 0;text-align:center;font-size:clamp(17px,2vw,20px);font-family:'Fraunces',serif;color:var(--gold-soft);line-height:1.5}
  @media(max-width:560px){.gate{grid-template-columns:1fr;gap:18px}}
  @media(max-width:640px){.gate-panel{padding:40px 26px 36px;border-radius:16px}}

  /* ---------------- FIT BANDS ---------------- */
  .fits{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;max-width:960px;margin:0 auto}
  .fit{background:#fff;border:1px solid var(--line);border-radius:14px;padding:36px 26px;text-align:center;border-top:4px solid var(--line);transition:transform .35s cubic-bezier(.2,.8,.2,1),box-shadow .35s}
  .fit:hover{transform:translateY(-8px);box-shadow:0 34px 58px -34px rgba(15,42,74,.36)}
  .fit.g{border-top-color:var(--green)}
  .fit.a{border-top-color:var(--gold)}
  .fit.r{border-top-color:var(--rust)}
  .fit-ic{width:64px;height:64px;border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 20px;transition:transform .35s}
  .fit:hover .fit-ic{transform:scale(1.1)}
  .fit.g .fit-ic{background:var(--green-bg)}
  .fit.a .fit-ic{background:var(--amber-bg)}
  .fit.r .fit-ic{background:var(--rust-bg)}
  .fit-ic svg{width:28px;height:28px}
  .fit h3{font-size:20px;margin-bottom:8px}
  .fit.g h3{color:var(--green)}
  .fit.a h3{color:var(--amber)}
  .fit.r h3{color:var(--rust)}
  .fit p{font-size:15px;color:var(--muted)}
  @media(max-width:720px){.fits{grid-template-columns:1fr;gap:16px}}
  .note{text-align:center;max-width:520px;margin:44px auto 0;font-size:14px;color:var(--muted)}

  .band-tag{display:block;font-family:'IBM Plex Mono',monospace;font-size:10.5px;letter-spacing:1.5px;text-transform:uppercase;margin-bottom:12px}
  .fit.g .band-tag{color:var(--green)}
  .fit.a .band-tag{color:var(--amber)}
  .fit.r .band-tag{color:var(--rust)}
  .fit-compare{margin-top:18px;padding-top:16px;border-top:1px solid var(--line);display:flex;flex-direction:column;gap:7px}
  .fit-compare .mini{display:flex;align-items:center;gap:8px}
  .fit-compare .mk{font-family:'IBM Plex Mono',monospace;font-size:10px;color:var(--muted);width:46px;flex:none;text-align:right}
  .fit-compare .mbar{flex:1;height:7px;background:var(--cream-2);border-radius:4px;overflow:hidden}
  .fit-compare .mbar i{display:block;height:100%;border-radius:4px}
  .fit-compare .mbar i.you{background:linear-gradient(90deg,var(--gold),var(--gold-soft))}
  .fit-compare .mbar i.them{background:#B7BFC8}

  /* ---------------- THE LANDSCAPE ---------------- */
  .land-grid{display:grid;grid-template-columns:1fr 1fr;gap:22px;max-width:1000px;margin:0 auto}
  .land-card{background:#fff;border:1px solid var(--line);border-radius:16px;padding:34px 32px;display:flex;flex-direction:column}
  .land-kind{font-family:'IBM Plex Mono',monospace;font-size:10.5px;letter-spacing:1.6px;text-transform:uppercase;color:var(--gold);margin-bottom:12px}
  .land-card h3{font-size:21px;color:var(--navy);margin-bottom:6px;letter-spacing:-.3px}
  .land-eg{font-size:13px;color:var(--muted);font-style:italic;margin-bottom:18px}
  .land-method{font-size:14.5px;color:var(--ink);line-height:1.6;padding-bottom:20px;margin-bottom:20px;border-bottom:1px solid var(--line)}
  .land-method b{font-family:'IBM Plex Mono',monospace;font-size:10.5px;letter-spacing:1.2px;text-transform:uppercase;color:var(--navy);display:block;margin-bottom:7px;font-weight:500}
  .land-split{display:flex;flex-direction:column;gap:16px;margin-top:auto}
  .ls span{font-family:'IBM Plex Mono',monospace;font-size:10.5px;letter-spacing:1.2px;text-transform:uppercase;display:block;margin-bottom:5px}
  .ls p{font-size:14px;color:var(--muted);line-height:1.55}
  .ls.yes span{color:var(--green)}
  .ls.no span{color:var(--rust)}
  @media(max-width:860px){.land-grid{grid-template-columns:1fr}}
  @media(max-width:560px){.land-card{padding:28px 22px}}

  .land-us{max-width:1000px;margin:26px auto 0;background:linear-gradient(150deg,var(--navy),var(--navy-deep));border-radius:16px;padding:38px 42px;position:relative;overflow:hidden}
  .land-us::before{content:"";position:absolute;top:-40%;right:-10%;width:420px;height:420px;background:radial-gradient(circle,rgba(201,161,59,0.16),transparent 62%);pointer-events:none}
  .land-us-label{position:relative;z-index:2;display:block;font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:2px;text-transform:uppercase;color:var(--gold);margin-bottom:12px}
  .land-us p{position:relative;z-index:2;font-size:clamp(16px,2vw,18px);color:#DCE4EC;line-height:1.65;max-width:760px}
  .land-us em{font-style:italic;color:var(--gold-soft)}
  @media(max-width:560px){.land-us{padding:30px 24px}}

  /* ---------------- INPUT CHIPS + PIPELINE ---------------- */
  .category-row{display:flex;flex-wrap:wrap;justify-content:center;gap:12px;max-width:920px;margin:0 auto}
  .category-chip{display:flex;align-items:center;gap:11px;background:#fff;border:1px solid var(--line);border-radius:30px;padding:8px 18px 8px 8px}
  .category-chip .ic-sm{width:34px;height:34px;border-radius:50%;background:var(--cream);display:flex;align-items:center;justify-content:center;flex:none}
  .category-chip .ic-sm svg{width:17px;height:17px}
  .category-chip span{font-size:13.5px;color:var(--navy);font-weight:500}

  .pipeline{display:flex;align-items:flex-start;justify-content:center;max-width:1000px;margin:64px auto 0;flex-wrap:wrap;padding-top:52px;border-top:1px solid var(--line)}
  .pipeline-stage{display:flex;flex-direction:column;align-items:center;text-align:center;width:130px}
  .pipeline-num{width:54px;height:54px;border-radius:50%;background:#fff;border:1px solid var(--line);display:flex;align-items:center;justify-content:center;margin-bottom:12px;flex:none}
  .pipeline-num svg{width:24px;height:24px}
  .pipeline-stage h4{font-family:'Fraunces',serif;font-size:15px;color:var(--navy);margin-bottom:4px;font-weight:500}
  .pipeline-stage p{font-size:11.5px;color:var(--muted);line-height:1.4}
  .pipeline-arrow{color:var(--gold);font-size:18px;align-self:center;margin:17px 2px 0;flex:none}
  @media(max-width:900px){
    .pipeline{flex-direction:column;align-items:center;gap:16px}
    .pipeline-stage{width:250px;flex-direction:row;text-align:left;gap:14px;align-items:center}
    .pipeline-num{margin-bottom:0}
    .pipeline-arrow{transform:rotate(90deg);margin:0}
  }

  /* ---------------- THE THREE INDICES ---------------- */
  .three-idx{display:grid;grid-template-columns:repeat(3,1fr);gap:22px;max-width:1000px;margin:0 auto}
  .card{background:#fff;border:1px solid var(--line);border-radius:14px;padding:32px 26px;text-align:center;display:flex;flex-direction:column}
  .card .ic{width:70px;height:70px;margin-bottom:18px}
  .card .ic svg{width:34px;height:34px}
  .card h3{font-size:20px;color:var(--navy);margin-bottom:8px}
  .card>p{font-size:14.5px;color:var(--muted)}
  .gauge{height:8px;background:var(--line);border-radius:4px;margin-top:20px;overflow:hidden}
  .gauge>span{display:block;height:100%;background:linear-gradient(90deg,var(--gold),var(--gold-soft));border-radius:4px}
  .gauge-cap{font-family:'IBM Plex Mono',monospace;font-size:11px;color:var(--muted);margin-top:8px;text-align:right}
  .card .role{align-self:center;margin-top:16px}
  .chip-row{display:flex;flex-wrap:wrap;gap:6px;justify-content:center;margin-top:16px}
  .tag{font-family:'IBM Plex Mono',monospace;font-size:10px;letter-spacing:.3px;color:var(--muted);background:var(--cream);border:1px solid var(--line);border-radius:20px;padding:4px 10px}
  .card-note{font-size:12.5px;color:var(--muted);font-style:italic;margin-top:14px;line-height:1.5}
  @media(max-width:820px){.three-idx{grid-template-columns:1fr;gap:16px}}

  .combine{margin-top:60px;text-align:center}
  .combine-label{display:block;font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:2px;text-transform:uppercase;color:var(--gold);margin-bottom:22px}
  .equation-row{display:flex;align-items:center;justify-content:center;flex-wrap:wrap;gap:10px 14px}
  .eq-chip{font-family:'IBM Plex Mono',monospace;font-size:12px;letter-spacing:.3px;padding:11px 16px;border-radius:8px;background:#fff;border:1px solid var(--line);color:var(--navy)}
  .eq-chip.core{background:var(--navy);color:#fff;border-color:var(--navy)}
  .eq-chip.final{background:var(--gold);color:var(--navy);border-color:var(--gold);font-weight:600}
  .eq-chip.adjust{border-style:dashed;color:var(--muted)}
  .eq-chip.adjust i{font-style:normal;color:#9A9890}
  .eq-op{font-family:'IBM Plex Mono',monospace;font-size:16px;color:var(--gold);flex:none}
  .equation-caption{text-align:center;font-size:13.5px;color:var(--muted);margin:20px auto 0;max-width:520px}

  /* ---------------- STANDARDIZE + BENCHMARK ---------------- */
  .method-grid{display:grid;grid-template-columns:1fr 1fr;gap:24px;max-width:960px;margin:0 auto}
  .method-card{background:#fff;border:1px solid var(--line);border-radius:14px;padding:32px 30px;text-align:center}
  .method-card .ic{width:70px;height:70px;margin-bottom:18px}
  .method-card .ic svg{width:34px;height:34px}
  .method-card h3{font-size:19px;color:var(--navy);margin-bottom:10px}
  .method-card p{font-size:14px;color:var(--muted)}
  .method-example{font-family:'IBM Plex Mono',monospace;font-size:11px;color:var(--navy);background:var(--cream);border:1px solid var(--line);border-radius:8px;padding:11px 12px;margin-top:16px}
  @media(max-width:800px){.method-grid{grid-template-columns:1fr}}

  .distribution-panel{background:#fff;border:1px solid var(--line);border-radius:14px;padding:34px 36px 26px;max-width:820px;margin:28px auto 0;text-align:center}
  .dist-label{font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:1.5px;text-transform:uppercase;color:var(--gold);margin-bottom:20px}
  .dist-caps{display:flex;justify-content:space-between;align-items:center;margin-top:12px;font-family:'IBM Plex Mono',monospace;font-size:10.5px;color:var(--muted);gap:10px;flex-wrap:wrap}
  .dist-legend{display:inline-flex;align-items:center;gap:6px}
  .dist-legend i{width:8px;height:8px;border-radius:50%;background:var(--gold);display:inline-block}
  @media(max-width:560px){.method-card,.distribution-panel{padding:26px 20px}}

  .pull-quote{max-width:640px;margin:44px auto 0;text-align:center;font-family:'Fraunces',serif;font-style:italic;font-size:clamp(19px,2.6vw,25px);color:#9A7E2E;line-height:1.4}

  /* ---------------- OUTPUT 1 ---------------- */
  .ex-athlete{max-width:760px;margin:0 auto 30px;background:#fff;border:1px solid var(--line);border-radius:14px;padding:22px 28px;display:flex;align-items:center;gap:26px;flex-wrap:wrap;justify-content:center}
  .ex-label{font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:1.5px;text-transform:uppercase;color:var(--gold);font-weight:500}
  .ex-stats{display:flex;gap:26px;flex-wrap:wrap}
  .ex-stat{text-align:center}
  .ex-stat b{display:block;font-family:'Fraunces',serif;font-size:22px;color:var(--navy);line-height:1;font-variant-numeric:tabular-nums}
  .ex-stat span{font-size:12px;color:var(--muted)}
  .cmp-list{max-width:760px;margin:0 auto;display:flex;flex-direction:column;gap:16px}
  .cmp{display:grid;grid-template-columns:1.1fr 1.5fr auto;align-items:center;gap:24px;background:#fff;border:1px solid var(--line);border-radius:12px;padding:20px 24px}
  .cmp-school{font-family:'Fraunces',serif;font-size:17px;color:var(--navy)}
  .cmp-bars{display:flex;flex-direction:column;gap:9px}
  .cmp-bars .mini{display:flex;align-items:center;gap:10px}
  .cmp-bars .mk{font-size:11px;color:var(--muted);width:98px;flex:none;text-align:right}
  .cmp-bars .mbar{flex:1;height:10px;background:var(--cream-2);border-radius:5px;overflow:hidden}
  .cmp-bars .mbar i{display:block;height:100%;border-radius:5px}
  .cmp-bars .mbar i.you{background:linear-gradient(90deg,var(--gold),var(--gold-soft))}
  .cmp-bars .mbar i.them{background:#9AA7B4}
  .chip{font-family:'IBM Plex Mono',monospace;font-size:11px;font-weight:500;padding:6px 12px;border-radius:2px;letter-spacing:.5px;white-space:nowrap;justify-self:end}
  .chip.s{background:rgba(44,86,136,0.08);color:#2C5688;border:1px solid rgba(44,86,136,0.3)}
  @media(max-width:640px){.cmp{grid-template-columns:1fr;gap:14px;text-align:center}.cmp-bars .mk{width:auto;text-align:left}.chip{justify-self:center}}
  .cmp-caption{text-align:center;max-width:560px;margin:26px auto 0;font-size:14px;color:var(--muted)}

  .confidence-wrap{max-width:620px;margin:44px auto 0}
  .confidence-bar{position:relative;height:14px;border-radius:7px;background:linear-gradient(90deg,#C3CFDC,#6C89A8,#2C5688)}
  .confidence-zone{position:absolute;top:-3px;bottom:-3px;background:rgba(255,255,255,0.55);border-radius:9px;border:1px solid rgba(255,255,255,0.85)}
  .confidence-marker{position:absolute;top:-6px;width:2px;height:26px;background:var(--navy)}
  .confidence-cap{display:flex;justify-content:space-between;font-family:'IBM Plex Mono',monospace;font-size:10.5px;color:var(--muted);margin-top:14px}

  /* ---------------- OUTPUT 2 ---------------- */
  .ladder{max-width:660px;margin:0 auto;display:flex;flex-direction:column;gap:12px}
  .rung{display:flex;align-items:center;gap:16px;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.12);border-left-width:5px;border-radius:10px;padding:16px 20px;text-align:left}
  .rung.g{border-left-color:var(--green)}
  .rung.a{border-left-color:var(--gold)}
  .rung.r{border-left-color:var(--rust)}
  .rung-k{font-weight:600;color:#fff;min-width:120px;font-size:15px}
  .rung-v{color:#A9B7C6;font-size:14.5px}
  @media(max-width:560px){.rung{flex-direction:column;align-items:flex-start;gap:4px}.rung-k{min-width:0}}
  .band-wrap{margin-top:44px}
  .band-scale{max-width:620px;margin:0 auto;height:12px;border-radius:6px;background:linear-gradient(90deg,var(--rust),var(--amber),var(--green))}
  .band-caps{max-width:620px;margin:12px auto 0;display:flex;justify-content:space-between;font-family:'IBM Plex Mono',monospace;font-size:11px;color:#A9B7C6;gap:8px}
  .gate-footnote{max-width:560px;margin:34px auto 0;text-align:center;font-size:14px;color:#8FA0B3;line-height:1.6}

  /* ---------------- LIMITATIONS ---------------- */
  .limit-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;max-width:960px;margin:0 auto}
  .limit-card{background:#fff;border:1px solid var(--line);border-radius:14px;padding:28px 24px;text-align:center}
  .limit-ic{width:52px;height:52px;border-radius:50%;background:var(--cream);border:1px solid var(--line);display:flex;align-items:center;justify-content:center;margin:0 auto 16px}
  .limit-ic svg{width:24px;height:24px}
  .limit-card h3{font-size:17px;color:var(--navy);margin-bottom:8px}
  .limit-card p{font-size:13.5px;color:var(--muted)}
  @media(max-width:720px){.limit-grid{grid-template-columns:1fr;gap:14px}}

  /* ---------------- PURCHASE ---------------- */
  .s.buy{background:linear-gradient(160deg,var(--navy),var(--navy-deep));position:relative;overflow:hidden;scroll-margin-top:72px}
  .s.buy::before{content:"";position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:820px;height:820px;background:radial-gradient(circle,rgba(201,161,59,0.13),transparent 60%);pointer-events:none}
  .buy-card{position:relative;z-index:2;display:grid;grid-template-columns:1.35fr .95fr;gap:0;max-width:960px;margin:0 auto;background:rgba(255,255,255,0.045);border:1px solid rgba(255,255,255,0.14);border-radius:20px;overflow:hidden}
  .buy-left{padding:48px 46px}
  .buy-left .eyebrow{display:block;margin-bottom:14px}
  .buy-left h2{font-size:clamp(28px,3.6vw,38px);color:#fff;margin-bottom:12px;letter-spacing:-.7px}
  .buy-left>p{font-size:16px;color:#C7D2DE;margin-bottom:26px}
  .buy-list{list-style:none;display:flex;flex-direction:column;gap:12px}
  .buy-list li{position:relative;padding-left:28px;font-size:15px;color:#DCE4EC;line-height:1.5}
  .buy-list li::before{content:"";position:absolute;left:0;top:9px;width:13px;height:7px;border-left:2px solid var(--gold);border-bottom:2px solid var(--gold);transform:rotate(-45deg)}
  .buy-right{padding:48px 40px;background:rgba(255,255,255,0.05);border-left:1px solid rgba(255,255,255,0.12);display:flex;flex-direction:column;align-items:center;text-align:center;justify-content:center}
  .buy-price{font-family:'Fraunces',serif;font-size:56px;color:var(--gold-soft);line-height:1;letter-spacing:-2px;font-variant-numeric:tabular-nums}
  .buy-price-sub{font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:1.6px;text-transform:uppercase;color:#8FA0B3;margin:10px 0 26px}
  .buy-btn{width:100%}
  .buy-fine{font-size:12.5px;color:#8FA0B3;margin-top:14px;line-height:1.5}
  .buy-or{display:flex;align-items:center;gap:12px;width:100%;margin:24px 0 18px;color:#7C8B9C;font-family:'IBM Plex Mono',monospace;font-size:10.5px;letter-spacing:2px;text-transform:uppercase}
  .buy-or::before,.buy-or::after{content:"";flex:1;height:1px;background:rgba(255,255,255,0.14)}
  .btn-ghost.dark{width:100%;justify-content:center;font-weight:500;font-size:14px;padding:13px 20px}
  .buy-note{position:relative;z-index:2;text-align:center;margin:30px auto 0;font-size:14px;color:#8FA0B3}
  .buy-note a{color:var(--gold-soft);text-decoration:underline;text-underline-offset:3px}
  .buy-note a:hover{color:var(--gold)}
  @media(max-width:820px){
    .buy-card{grid-template-columns:1fr}
    .buy-left{padding:38px 30px}
    .buy-right{padding:38px 30px;border-left:none;border-top:1px solid rgba(255,255,255,0.12)}
  }

  /* ---------------- MOTION / RESPONSIVE ---------------- */
  @media(prefers-reduced-motion:reduce){
    .reveal,.fx{opacity:1!important;transform:none!important;transition:none!important}
    .hero.lit h1 em::after{transform:none!important}
  }
  @media(max-width:760px){
    .s{padding:78px 0}
    .chapter{padding:64px 0}
    .scroll-cue{display:none}
    .hero-actions{flex-direction:column;width:100%;max-width:320px}
