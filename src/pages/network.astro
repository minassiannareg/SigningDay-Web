---
import Base from '../layouts/Base.astro';
import PersonCard from '../components/PersonCard.astro';
import { networkSections } from '../data/network';

/*
  Every section on this page is generated from src/data/network.ts.
  Adding a professional is a one-object edit to that file - no markup here
  changes. See the header comment in network.ts for the template.

  Empty sections are shown, not hidden, and all three use the same panel.
  Hiding them would leave this page as a heading over nothing today, and
  the categories themselves are the useful signal: a family reading it
  learns that SDA will have a trainer, a tutor and a nutritionist to point
  them to. The panel doubles as the intake route for referrals.
*/
const contact = 'info@signingdayadvisors.com';
---

<Base
  title="Our Network"
  description="Trainers, tutors, and nutritionists Signing Day Advisors refers families to - independent professionals who work with student-athletes through the recruiting years."
  extraDisclaimer="Professionals listed under Our Network are independent third parties. They are not employed by or affiliated with Signing Day Advisors, and families engage them directly."
>

<!-- HERO -->
<section class="net-hero">
  <div class="wrap net-hero-inner">

    <span class="eyebrow">Our Network</span>

    <h1>The people we send families to.</h1>

    <p class="net-lead">Recruiting is only one part of the work. An athlete also has to get stronger, raise a test score, and eat like someone training eleven times a week. We don't do those things, so we keep a short list of people who do.</p>

    <p class="net-lead net-lead-sub">Everyone here works independently of SDA. We make the introduction and step back; you decide who is right for your athlete.</p>

    <ul class="net-jump">
      {networkSections.map((s) => (
        <li>
          <a href={`#${s.id}`}>
            {s.label}
            {s.people.length > 0 && <span class="net-jump-count">{s.people.length}</span>}
          </a>
        </li>
      ))}
    </ul>

  </div>
</section>


<!-- SECTIONS -->
{networkSections.map((s, i) => (
  <section class={i % 2 === 1 ? 'net-section net-section-alt' : 'net-section'} id={s.id}>
    <div class="wrap">

      <header class="net-head">
        <span class="eyebrow">{s.eyebrow}</span>
        <h2>{s.label}</h2>
        <p class="net-blurb">{s.blurb}</p>
      </header>

      {s.people.length > 0 ? (
        <div class="net-grid">
          {s.people.map((p) => <PersonCard person={p} />)}
        </div>
      ) : (
        <div class="net-empty">
          <p class="net-empty-label">Coming soon</p>
          <p class="net-empty-copy">
            We are still vetting {s.label.toLowerCase()} for this list. We would rather
            name nobody than name someone we would not send our own athletes to.
          </p>
          <a
            class="net-empty-link"
            href={`mailto:${contact}?subject=${encodeURIComponent('Our Network — ' + s.label)}`}
          >
            Recommend a {s.singular}
            <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
      )}

    </div>
  </section>
))}


<!-- CLOSING -->
<section class="net-closing">
  <div class="wrap net-closing-inner">

    <span class="eyebrow">Not sure where to start</span>

    <h2>Tell us what your athlete needs.</h2>

    <p>A free, fifteen-minute consultation to talk through where your athlete stands, and who in our network is worth an introduction.</p>

    <a class="btn-gold" href="/contact">Book a free consultation</a>

  </div>
</section>

</Base>

<style is:global>

/* ---------- HERO ---------- */

.net-hero{background:var(--navy);color:#fff;padding:96px 0 84px}

.net-hero-inner{max-width:860px}

.net-hero .eyebrow{display:block;margin-bottom:18px}

.net-hero h1{font-size:clamp(40px,5vw,62px);line-height:1.05;color:#fff;margin:0 0 28px;text-wrap:balance}

.net-lead{font-size:17px;line-height:1.7;color:#C7D2DE;max-width:680px;margin:0 0 16px}

.net-lead-sub{font-size:15.5px;color:#9FB0C2}

/* Jump row. It carries a count only once a section has entries, so it
   does not advertise three zeroes on the day the page ships. */
.net-jump{list-style:none;display:flex;flex-wrap:wrap;gap:10px;margin:36px 0 0;padding:0}

.net-jump a{
  display:inline-flex;align-items:center;gap:8px;
  font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:1.6px;
  text-transform:uppercase;color:#C7D2DE;
  border:1px solid rgba(201,161,59,0.35);border-radius:2px;
  padding:9px 14px;transition:color .2s,border-color .2s,background .2s;
}

.net-jump a:hover{color:var(--navy);background:var(--gold-soft);border-color:var(--gold-soft)}

.net-jump-count{color:var(--gold)}

.net-jump a:hover .net-jump-count{color:var(--navy)}


/* ---------- SECTIONS ---------- */

.net-section{padding:76px 0 84px;background:#fff;scroll-margin-top:88px}

/* Alternation comes from the loop index, not nth-of-type: the sections
   share <main> with the hero and the closing band, so a positional
   selector would re-stripe the page the moment either one moves. */
.net-section-alt{background:var(--cream-2);border-top:1px solid var(--line);border-bottom:1px solid var(--line)}

.net-head{max-width:720px;margin:0 0 44px}

.net-head .eyebrow{display:block;margin-bottom:10px}

.net-head h2{font-size:clamp(30px,3.6vw,44px);line-height:1.08;color:var(--navy);margin:0}

.net-blurb{font-size:15px;line-height:1.7;color:var(--muted);margin:14px 0 0}


/* ---------- CARD GRID ---------- */

.net-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:44px 28px}


/* ---------- EMPTY STATE ---------- */

/* One treatment for all three sections. The dotted rule reads as a slot
   waiting to be filled rather than as a broken card. */
.net-empty{
  border:1px dashed var(--line);border-radius:6px;
  padding:44px 38px;max-width:620px;background:rgba(255,255,255,0.55);
}

.net-empty-label{
  font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:2.5px;
  text-transform:uppercase;color:var(--gold);margin:0 0 12px;font-weight:500;
}

.net-empty-copy{font-size:15px;line-height:1.7;color:var(--muted);margin:0 0 20px}

.net-empty-link{
  display:inline-flex;align-items:center;gap:6px;font-size:14px;color:var(--navy);
  border-bottom:1px solid var(--gold);padding-bottom:2px;transition:color .2s;
}

.net-empty-link span{color:var(--gold)}

.net-empty-link:hover{color:var(--gold)}


/* ---------- CLOSING ---------- */

.net-closing{background:var(--navy);color:#fff;padding:84px 0;text-align:center}

.net-closing-inner{max-width:680px}

.net-closing .eyebrow{display:block;margin-bottom:18px}

.net-closing h2{font-size:clamp(30px,4vw,46px);line-height:1.1;color:#fff;margin:0 auto 22px}

.net-closing p{font-size:16px;color:#C7D2DE;max-width:520px;margin:0 auto 32px}

.net-closing .btn-gold{border-radius:2px}


/* ---------- RESPONSIVE ---------- */

@media(max-width:1000px){
  .net-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:42px 26px}
}

@media(max-width:760px){
  .net-hero{padding:72px 0 64px}
  .net-section{padding:60px 0 68px}
  .net-empty{padding:34px 26px}
}

@media(max-width:600px){
  .net-grid{grid-template-columns:1fr;gap:46px}
  .net-jump{gap:8px}
  .net-jump a{font-size:10px;padding:8px 11px}
}

</style>
