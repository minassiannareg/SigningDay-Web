---
import Base from '../layouts/Base.astro';
---

<Base
  title="College recruiting, simplified."
  scrollBar
  description="We offer tailored guidance so that our athletes can find universities that align with their athletic and academic ambitions."
  rawTitle
>

<!-- HERO -->
<header class="hero" id="top">
  <div class="wrap">
    <div class="hero-inner">
      <span class="eyebrow">Student-Athlete Recruiting Advisory </span>
      <h1>College recruiting<br><em>made clearer.</em></h1>
      <p class="lead">Signing Day Advisors offers personalized guidance for high-achieving student-athletes navigating academically competitive universities.</p>
      <div class="hero-ctas">
        <a class="btn-gold" href="contact/">Book a free consultation</a>
        <a class="btn-ghost" href="#sda-compass-teaser">See the SDA Compass <span>→</span></a>
      </div>
    </div>

    <div class="hero-radar-wrap radar-reveal">
      <svg class="hero-radar" id="heroRadar" viewBox="0 0 480 480" role="img" aria-labelledby="radarTitle radarDesc" xmlns="http://www.w3.org/2000/svg">
        <title id="radarTitle">The Complete Profile — a seven-axis view of a recruiting profile</title>
        <desc id="radarDesc">An illustrative radar chart plotting a sample student-athlete's recruiting profile across seven dimensions: academic index, test scores, event performance, national ranking, character and essays, coach and program fit, and recruiting timeline. A shaded band on each axis marks the range competitive target-tier programs typically expect. The athlete's profile, drawn in gold, meets or exceeds that band on most dimensions, sits right at its edge on national ranking, and falls below it on recruiting timeline — showing at a glance where the profile is strong and where it still has ground to close.</desc>
        <g class="r-rings" id="radarRings"></g>
        <g class="r-band" id="radarBandGroup"><path id="radarBand" fill-rule="evenodd"></path></g>
        <g class="r-athlete" id="radarAthleteGroup">
          <polygon id="radarAthletePoly"></polygon>
          <g id="radarAthleteDots"></g>
        </g>
        <g class="r-labels" id="radarLabels"></g>
      </svg>
    </div>
  </div>
</header>

<!-- DIFFERENTIATORS -->
<section id="why">
  <div class="wrap">
    <div class="section-head reveal">
      <span class="eyebrow">Why us</span>
      <h2>Recruiting should not feel like a blind guess. <em>Learn where your athlete stands.</em></h2> 
      <p>Leverage our diligent team to see your athlete's raw data translated into tangible recruiting targets.</p>
    </div>
    <div class="diff-grid reveal">
      <div class="diff">
        <div class="num">01</div>
        <h3>Athletes with Experience</h3>
        <p>SDA was founded by college athletes who know both how to thrive as a student-athlete and how to get there in the first place. </p>

        <a href="team/" class="diff-link">Meet the Team <span>→</span></a>
      </div>
      <div class="diff">
        <div class="num">02</div>
        <h3>Transparent Assessment</h3>
        <p>We compare your statistics to active college rosters. This lets you get an honest gauge of where you stand, and shows you what you can do to get to the next level.</p>
        <a href="academic-index/" class="diff-link">Explore SDA Compass <span>→</span></a>
      </div>
      <div class="diff">
        <div class="num">03</div>
        <h3>Dynamic Strategy</h3>
        <p>SDA constantly tracks your progress, and adjusts your recruiting strategy to help you continue to achieve your goals.</p>
        <a href="packages/" class="diff-link"> Explore Packages <span>→</span></a>
      </div>
    </div>
  </div>
</section>

<!-- PROCESS -->
<section class="process" id="approach">
  <div class="wrap">
    <div class="section-head reveal">
      <span class="eyebrow">Our approach</span>
      <h2>A recruiting strategy tailored to your athlete.</h2>
      <p>From the initial assessment to signing day, each stage of our process is designed around your athlete's goals, profile, and recruiting timeline.</p>
    </div>
    <div class="steps reveal">
      <div class="step" tabindex="0">
        <div class="step-num">01</div>
        <div class="step-circle"><span>Assess</span></div>
        <div class="step-kicker">Know where you stand</div>
        <p class="step-detail">Compare academics, athletics, and recruiting readiness against your athlete's desired programs.</p>
        <p class="step-deliverable">Academic & Athletic Benchmarking</p>
      </div>
      <div class="step" tabindex="0">
        <div class="step-num">02</div>
        <div class="step-circle"><span>Strategize</span></div>
        <div class="step-kicker">Build the right roadmap</div>
        <p class="step-detail">Create a personalized school strategy, recruiting timeline, and action plan around your athlete's goals.</p>
        <p class="step-deliverable">School Strategy & Recruiting Timeline</p>
      </div>
      <div class="step" tabindex="0">
        <div class="step-num">03</div>
        <div class="step-circle"><span>Build</span></div>
        <div class="step-kicker">Strengthen your profile</div>
        <p class="step-detail">Develop the academic, athletic and communicative tools that drive the recruiting process.</p>
        <p class="step-deliverable">Profile & Outreach & Development</p>
      </div>
      <div class="step" tabindex="0">
        <div class="step-num">04</div>
        <div class="step-circle"><span>Sign</span></div>
        <div class="step-kicker">Choose with confidence</div>
        <p class="step-detail">Manage visits, offers, financial elements, and the final decision with a clear understanding of your options.</p>
        <p class="step-deliverable">Offer Comparison & Decision Support</p>
      </div>
    </div>
    <p class="process-closing reveal">One coordinated strategy, from first assessment to<span> signing day.</span></p>
  </div>
</section>

<!-- SDA COMPASS TEASER -->
<section id="sda-compass-teaser" style="background:var(--white-warm)">
  <div class="wrap">
    <a class="compass-card reveal" href="academic-index/">
      <div class="compass-text">
        <span class="eyebrow compass-eyebrow">
          <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <circle cx="12" cy="12" r="10" stroke="#C9A13B" stroke-width="1.4"/>
            <path d="M12 5 L14.2 12 L12 19 L9.8 12 Z" fill="#C9A13B"/>
            <circle cx="12" cy="12" r="1.4" fill="#0F2A4A"/>
          </svg>
          SDA Compass
        </span>
        <h2>See where your athlete fits in</h2>
        <p>SDA Compass encapsulates our entire recruiting-fit analysis in one measure. It first integrates athletic strength and student profile with the actual academic indices that schools use. It then compares this metric to relevant schools, revealing how your athlete fits with each program that they are interested in.</p>
        <span class="compass-link">Explore SDA Compass <span>→</span></span>
      </div>
      <div class="compass-readout">
        <div class="cr-head">
          <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <circle cx="12" cy="12" r="10" stroke="#C9A13B" stroke-width="1.4"/>
            <path d="M12 5 L14.2 12 L12 19 L9.8 12 Z" fill="#C9A13B"/>
            <circle cx="12" cy="12" r="1.4" fill="#F3F1EA"/>
          </svg>
          <span class="cr-title">SDA Compass</span>
        </div>
        <div class="cr-axes">
          <div class="cr-axis"><span class="cr-k">Academics</span><span class="cr-v">Band A</span></div>
          <div class="cr-axis"><span class="cr-k">Athletics</span><span class="cr-v">Strong</span></div>
          <div class="cr-axis"><span class="cr-k">Profile</span><span class="cr-v">High</span></div>
        </div>
        <div class="cr-fit">
          <span class="cr-fit-k">Fit</span>
          <span class="cr-fit-v">Realistic</span>
        </div>
        <span class="cr-note">Illustrative</span>
      </div>
    </a>
  </div>
</section>

<!-- PROGRAMS -->
<section id="programs" style="background:var(--white-warm)">
  <div class="wrap">
    <a class="programs-card reveal" href="packages/">
  <div class="programs-text">
  <span class="eyebrow">Packages</span>
    <h2>Choose the level of support that aligns with your goals.</h2>
  <span class="programs-link">Explore Packages <span>→</span></span>
  </div>

  <div class="programs-graphic">
  <div class="pg-top">
  <span>Base</span>
  <span>Premium</span>
  <span>Monthly</span>
  </div>
  <div class="pg-mini-chart">
  <span class="pg-check"></span>
  <span class="pg-check"></span>
  <span class="pg-check"></span>

  <span class="pg-check"></span>
  <span class="pg-check"></span>
  <span class="pg-dash"></span>

  <span class="pg-dash"></span>
  <span class="pg-check"></span>
  <span class="pg-check"></span>

  <span class="pg-dash"></span>
  <span class="pg-check"></span>
  <span class="pg-check"></span>
  </div>
  <span class="pg-caption">SERVICE SNAPSHOT</span>
  </div>
  </a>
  </div>
</section>

<!-- CLOSING -->
<section class="closing" id="contact">
  <div class="wrap reveal">
    <h2>Start with an honest conversation.</h2>
    <p>A free, fifteen-minute consultation to talk through where your athlete stands and whether we're the right fit.</p>
    <a class="btn-gold" href="contact/">Book a free consultation</a>
  </div>
</section>

</Base>

<style is:global>
 
  /* ---------- NAV ---------- */
  nav{
  position:sticky;top:0;z-index:50;
  background:rgba(15,42,74,0.96);
  backdrop-filter:blur(8px);
  border-bottom:1px solid rgba(201,161,59,0.25);
  }

  @media(max-width:760px){
  section{padding:72px 0}
  }

  /* ---------- HERO ---------- */
  .hero{background:var(--navy);color:var(--white-warm);position:relative;overflow:hidden}
  .hero .wrap{display:grid;grid-template-columns:minmax(0,1fr) 420px;gap:56px;align-items:center}
  .hero-inner{padding:110px 0 120px;position:relative;z-index:2;max-width:640px}
  .hero .eyebrow{margin-bottom:26px}
  .hero h1{font-size:clamp(40px,6vw,68px);color:#fff;margin-bottom:28px}
  .hero h1 em{font-style:italic;color:var(--gold-soft)}
  .hero p.lead{font-size:19px;color:#C7D2DE;max-width:560px;margin-bottom:40px}
  .hero-ctas{display:flex;gap:16px;flex-wrap:wrap;align-items:center}
  .btn-gold{background:var(--gold);color:var(--navy);padding:15px 30px;border-radius:2px;font-size:15px;font-weight:600;transition:all .2s}
  .btn-gold:hover{background:var(--gold-soft);transform:translateY(-1px)}
  .btn-ghost{color:#C7D2DE;font-size:15px;padding:15px 8px;transition:color .2s}
  .btn-ghost:hover{color:#fff}
  .btn-ghost span{color:var(--gold);margin-left:6px}

  /* ---------- HERO RADAR — "The Complete Profile" ---------- */
  .hero-radar-wrap{position:relative;width:100%;z-index:1;pointer-events:none}
  .hero-radar{width:100%;height:auto;display:block;overflow:visible}
  .hero-radar .ring{fill:none;stroke:#C7D2DE;stroke-width:1;opacity:.14}
  .hero-radar .spoke{stroke:#C7D2DE;stroke-width:1;opacity:.16}
  .hero-radar .tick-label{font-family:'IBM Plex Mono',monospace;font-size:9px;fill:#8FA0B3}
  .hero-radar #radarBand{fill:rgba(201,161,59,.16);stroke:rgba(201,161,59,.6);stroke-width:1;stroke-dasharray:3 3}
  .hero-radar #radarAthletePoly{fill:rgba(201,161,59,.32);stroke:var(--gold);stroke-width:2;stroke-linejoin:round}
  .hero-radar .athlete-dot{fill:var(--gold)}
  .hero-radar .axis-label{font-family:'IBM Plex Mono',monospace;font-size:13px;fill:#C7D2DE;letter-spacing:.4px}
  .hero-radar .axis-label-short{display:none}

  .hero-radar .r-rings{opacity:0;transition:opacity .4s ease}
  .hero-radar .r-band{opacity:0;transform:scale(.94);transform-box:fill-box;transform-origin:50% 50%;transition:opacity .45s ease .28s,transform .45s ease .28s}
  .hero-radar .r-athlete{opacity:0;transform:scale(.7);transform-box:fill-box;transform-origin:50% 50%;transition:opacity .4s cubic-bezier(.2,.8,.2,1) .55s,transform .5s cubic-bezier(.2,.8,.2,1) .55s}
  .hero-radar .r-labels{opacity:0;transition:opacity .4s ease .82s}
  .radar-reveal.in .r-rings{opacity:1}
  .radar-reveal.in .r-band{opacity:1;transform:scale(1)}
  .radar-reveal.in .r-athlete{opacity:1;transform:scale(1)}
  .radar-reveal.in .r-labels{opacity:1}

  @media(prefers-reduced-motion:reduce){
    .hero-radar .r-rings,.hero-radar .r-band,.hero-radar .r-athlete,.hero-radar .r-labels{opacity:1!important;transform:none!important;transition:none!important}
  }

  @media(max-width:1080px){
    .hero .wrap{grid-template-columns:1fr;gap:0}
    .hero-inner{padding:96px 0 0;max-width:none}
    .hero-radar-wrap{width:min(340px,86vw);margin:40px auto 0;padding-bottom:96px;pointer-events:auto}
    .hero-radar .axis-label-full{display:none}
    .hero-radar .axis-label-short{display:inline}
  }

  /* ---------- SECTIONS ---------- */
  section{padding:96px 0}
  .section-head{max-width:640px;margin-bottom:56px}
  .section-head .eyebrow{color:var(--gold);margin-bottom:18px;display:block}
  .section-head h2{font-size:clamp(30px,4vw,42px);color:var(--navy);margin-bottom:18px}
  .section-head p{font-size:17px;color:var(--muted)}

  /* differentiators */
  .diff-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:0;border-top:1px solid var(--line)}
  .diff{padding:36px 28px;border-right:1px solid var(--line)}
  .diff:first-child{padding-left:0}
  .diff:last-child{border-right:none;padding-right:0}
  .diff .num{font-family:'IBM Plex Mono',monospace;font-size:13px;color:var(--gold);margin-bottom:18px}
  .diff h3{font-size:22px;color:var(--navy);margin-bottom:12px}
  .diff p{font-size:15px;color:var(--muted)}
  .diff-link{display:inline-flex; align-items:center; gap:6px; margin-top:18px; color:var(--navy); font-size:14px; font-weight:600; transition:color .2s}
  .diff-link span {color:var(--gold); transition:transform .2s;}
  .diff-link:hover {color:var(--gold)}
  .diff-link:hover span{transform:translateX(4px)}
  #why h2 em{font-style:normal;color:var(--gold-soft)}
  @media(max-width:760px){
    .diff-grid{grid-template-columns:1fr}
    .diff{border-right:none;border-bottom:1px solid var(--line);padding:32px 0}
  }

  /* process */
  .process{background:var(--navy);color:var(--white-warm);padding:88px 0 80px}
  .process .section-head{max-width:820px;margin-bottom:54px}
  .process .section-head h2{color:#fff;font-size:clamp(34px,4.5vw,52px)}
  .process .section-head p{color:#C7D2DE;max-width:680px}
  .steps{display:grid;grid-template-columns:repeat(4,1fr);gap:0;position:relative;max-width:1050px;margin:0 auto}
  .steps::before{content:"";position:absolute;top:91px;left:12.5%;right:12.5%;height:2px;background:linear-gradient(90deg,rgba(201,161,59,.25),rgba(201,161,59,.9),rgba(201,161,59,.25));z-index:0}
  .step{text-align:center;position:relative;padding:0 18px;min-height:330px;cursor:pointer}
  .step-num{font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:2px;color:var(--gold);margin-bottom:10px}
  .step-circle{width:132px;height:132px;border:1.5px solid var(--gold);border-radius:50%;margin:0 auto;display:flex;align-items:center;justify-content:center;position:relative;z-index:2;background:var(--navy);transition:transform .25s ease,background .25s ease,box-shadow .25s ease}
  .step-circle span{font-family:'Fraunces',serif;font-size:21px;color:#fff}
  .step:last-child .step-circle{border-width:2px;box-shadow:0 0 0 8px rgba(201,161,59,.08)}
  .step-kicker{margin-top:18px;font-family:'IBM Plex Mono',monospace;font-size:10px;letter-spacing:1.2px;text-transform:uppercase;color:var(--gold-soft)}
  .step-detail{margin:8px auto 0;max-width:210px;font-size:14px;line-height:1.55;color:#C7D2DE;opacity:0;transform:translateY(8px);transition:opacity .25s ease,transform .25s ease}
  .step-deliverable{margin:10px auto 0;max-width:210px;font-size:12px;line-height:1.45;color:#8FA0B3;opacity:0;transform:translateY(8px);transition:opacity .25s ease .04s,transform .25s ease .04s}
  .step:hover .step-circle{background:var(--gold);transform:translateY(-6px);box-shadow:0 16px 30px -18px rgba(0,0,0,.55)}
  .step:hover .step-circle span{color:var(--navy)}
  .step:hover .step-detail,.step:hover .step-deliverable{opacity:1;transform:translateY(0)}
  .step.active .step-circle{background:var(--gold);transform:translateY(-6px)}
  .step.active .step-circle span{color:var(--navy)}
  .step.active .step-detail,.step.active .step-deliverable{opacity:1;transform:translateY(0)}
  .process-closing{margin:34px auto 0;text-align:center;font-family:'Fraunces',serif;font-size:19px;color:#fff}
  .process-closing span{color:var(--gold-soft)}
  @media(max-width:760px){.steps{grid-template-columns:repeat(2,1fr);gap:42px 20px}.steps::before{display:none}.step{min-height:auto}.step-circle{width:112px;height:112px}.step-detail,.step-deliverable{opacity:0;transform:translateY(8px)}.step.active .step-detail,.step.active .step-deliverable{opacity:1;transform:translateY(0)}.process{padding:64px 0}}
  @media(max-width:480px){.steps{grid-template-columns:1fr}}

  /* assessment feature */
  .assess{display:grid;grid-template-columns:1.1fr 0.9fr;gap:64px;align-items:center}
  @media(max-width:860px){.assess{grid-template-columns:1fr;gap:40px}}
  .assess .eyebrow{display:block;margin-bottom:18px}
  .assess h2{font-size:clamp(28px,3.5vw,38px);color:var(--navy);margin-bottom:20px}
  .assess p{font-size:16px;color:var(--muted);margin-bottom:16px}
  .assess ul{list-style:none;margin:24px 0 32px}
  .assess li{font-size:15px;color:var(--ink);padding:11px 0;border-bottom:1px solid var(--line);display:flex;gap:12px}
  .assess li::before{content:"—";color:var(--gold);font-weight:600}
  .assess-card{
    background:var(--navy);border-radius:6px;padding:36px;color:var(--white-warm);
    border:1px solid var(--navy-soft);box-shadow:0 30px 60px -30px rgba(10,30,56,0.5);
  }
  .assess-card .ac-label{font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:2px;color:var(--gold);text-transform:uppercase}
  .assess-card .ac-name{font-family:'Fraunces',serif;font-size:24px;color:#fff;margin:8px 0 24px}
  .ac-row{display:flex;justify-content:space-between;align-items:baseline;padding:14px 0;border-top:1px solid rgba(255,255,255,0.1)}
  .ac-row .k{font-size:13px;color:#A9B7C6}
  .ac-row .v{font-family:'IBM Plex Mono',monospace;font-size:20px;color:var(--gold-soft);font-weight:500}
  .ac-foot{font-size:12px;color:#7E8C9B;margin-top:20px}

 /* programs */
  .programs-card{display:flex;align-items:stretch;justify-content:space-between;gap:48px;background:#fff;border:1px solid var(--line);border-radius:10px;padding:44px 48px 44px 52px;position:relative;overflow:hidden;transition:all .25s}
  .programs-card::before{content:"";position:absolute;left:0;top:0;bottom:0;width:4px;background:linear-gradient(180deg,var(--gold),var(--gold-soft))}
  .programs-card:hover{transform:translateY(-3px);box-shadow:0 30px 50px -30px rgba(15,42,74,.35);border-color:var(--gold)}
  .programs-text{max-width:590px;align-self:center}
  .programs-text .eyebrow{display:block;margin-bottom:14px}
  .programs-text h2{font-size:clamp(26px,3vw,36px);color:var(--navy);margin-bottom:14px}
  .programs-text p{font-size:16px;color:var(--muted);margin-bottom:22px}
  .programs-link{font-size:15px;color:var(--navy);font-weight:600;display:inline-flex;align-items:center;gap:6px}
  .programs-link span{color:var(--gold);transition:transform .2s}
  .programs-card:hover .programs-link span{transform:translateX(4px)}
  .programs-graphic{flex:none;width:270px;background:var(--navy);border-radius:8px;padding:22px 22px 18px;display:flex;flex-direction:column;justify-content:center}
  .pg-top{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:14px}
  .pg-top span{font-family:'IBM Plex Mono',monospace;font-size:10px;letter-spacing:1px;text-transform:uppercase;color:var(--gold-soft);text-align:center}
  .pg-mini-chart{display:grid;grid-template-columns:repeat(3,1fr);gap:10px 10px}
  .pg-mini-chart span{height:34px;border:1px solid rgba(255,255,255,.12);border-radius:6px;display:flex;align-items:center;justify-content:center;background:rgba(255,255,255,.03)}
  .pg-check::before{content:"✓";font-size:16px;font-weight:600;color:var(--gold-soft)}
  .pg-dash::before{content:"—";font-size:18px;color:#7E8C9B}
  .pg-caption{font-family:'IBM Plex Mono',monospace;font-size:9px;letter-spacing:1.5px;color:#7E8C9B;text-align:right;margin-top:14px}
  @media(max-width:760px){.programs-card{flex-direction:column;padding:32px 24px 32px 28px;gap:26px}.programs-graphic{width:100%}}

  /* closing CTA */
  .closing{background:var(--cream-2);text-align:center}
  .closing h2{font-size:clamp(30px,4vw,46px);color:var(--navy);max-width:640px;margin:0 auto 22px}
  .closing p{font-size:17px;color:var(--muted);max-width:500px;margin:0 auto 34px}

  /* footer */
  footer{background:var(--navy-deep);color:#8FA0B3;padding:64px 0 40px}

  /* ---------- SDA COMPASS TEASER ---------- */
  .compass-card{
    display:flex;align-items:stretch;justify-content:space-between;gap:48px;
    background:#fff;border:1px solid var(--line);border-radius:10px;
    padding:44px 48px 44px 52px;transition:all .25s;position:relative;overflow:hidden;
  }
  .compass-card::before{content:"";position:absolute;left:0;top:0;bottom:0;width:4px;background:linear-gradient(180deg,var(--gold),var(--gold-soft))}
  .compass-card:hover{transform:translateY(-3px);box-shadow:0 30px 50px -30px rgba(15,42,74,0.35);border-color:var(--gold)}
  .compass-text{max-width:560px;align-self:center}
  .compass-eyebrow{display:inline-flex;align-items:center;gap:9px;margin-bottom:14px}
  .compass-eyebrow svg{width:18px;height:18px;flex:none}
  .compass-text h2{font-size:clamp(26px,3vw,36px);color:var(--navy);margin:0 0 14px;line-height:1.12}
  .compass-text p{font-size:16px;color:var(--muted);margin-bottom:22px}
  .compass-link{font-size:15px;color:var(--navy);font-weight:600;display:inline-flex;align-items:center;gap:6px}
  .compass-link span{color:var(--gold);transition:transform .2s}
  .compass-card:hover .compass-link span{transform:translateX(4px)}
  
  /* readout */
  .compass-readout{flex:none;width:252px;background:var(--navy);border-radius:8px;padding:24px 26px;display:flex;flex-direction:column;box-shadow:0 20px 40px -26px rgba(10,30,56,0.6)}
  .cr-head{display:flex;align-items:center;gap:10px;padding-bottom:16px;border-bottom:1px solid rgba(255,255,255,0.12);margin-bottom:15px}
  .cr-head svg{width:22px;height:22px;flex:none}
  .cr-title{font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:2px;color:var(--gold);text-transform:uppercase}
  .cr-axes{display:flex;flex-direction:column;gap:12px}
  .cr-axis{display:flex;justify-content:space-between;align-items:baseline}
  .cr-k{font-size:13px;color:#A9B7C6}
  .cr-v{font-family:'IBM Plex Mono',monospace;font-size:13px;color:#fff}
  .cr-fit{display:flex;justify-content:space-between;align-items:center;margin-top:16px;padding-top:15px;border-top:1px solid rgba(255,255,255,0.12)}
  .cr-fit-k{font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:1.5px;text-transform:uppercase;color:var(--gold)}
  .cr-fit-v{font-family:'Fraunces',serif;font-size:21px;color:var(--gold-soft)}
  .cr-note{font-size:10.5px;color:#7E8C9B;margin-top:12px;text-align:right;font-family:'IBM Plex Mono',monospace}
  @media(max-width:760px){
    .compass-card{flex-direction:column;align-items:stretch;padding:32px 24px 32px 28px;gap:26px}
    .compass-readout{width:auto}
  }
</style>

<script is:inline>
document.querySelectorAll('.step').forEach(step=>{
    step.addEventListener('click',()=>{
      step.classList.toggle('active');
    });
  });

  // ---------- HERO RADAR — "The Complete Profile" ----------
  (function(){
    const axes = [
      { label:'Academic Index', short:'Academic', value:82, bandMin:65, bandMax:90 },
      { label:'Test Scores',    short:'Tests',    value:78, bandMin:60, bandMax:88 },
      { label:'Event Performance', short:'Events', value:85, bandMin:70, bandMax:95 },
      { label:'National Rank',  short:'Ranking',  value:60, bandMin:55, bandMax:85 },
      { label:'Character',      short:'Essays',   value:88, bandMin:60, bandMax:90 },
      { label:'Program Fit',    short:'Fit',      value:74, bandMin:65, bandMax:92 },
      { label:'Timeline',       short:'Timeline', value:55, bandMin:60, bandMax:90 }
    ];

    const svg = document.getElementById('heroRadar');
    if(!svg) return;

    const NS = 'http://www.w3.org/2000/svg';
    const CX = 240, CY = 240, MAX_R = 155, LABEL_R = MAX_R + 32;
    const N = axes.length;

    function angleFor(i){ return -90 + i * (360 / N); }
    function pointAt(r, i){
      const a = angleFor(i) * Math.PI / 180;
      return { x: CX + r * Math.cos(a), y: CY + r * Math.sin(a), cos: Math.cos(a), sin: Math.sin(a) };
    }
    function polyPoints(radiusForIndex){
      return axes.map((_, i) => {
        const p = pointAt(radiusForIndex(i), i);
        return p.x.toFixed(1) + ',' + p.y.toFixed(1);
      }).join(' ');
    }
    function pathFor(radiusForIndex){
      return axes.map((_, i) => {
        const p = pointAt(radiusForIndex(i), i);
        return (i === 0 ? 'M' : 'L') + p.x.toFixed(1) + ',' + p.y.toFixed(1);
      }).join(' ') + ' Z';
    }
    function makeEl(name, attrs){
      const e = document.createElementNS(NS, name);
      for(const k in attrs) e.setAttribute(k, attrs[k]);
      return e;
    }

    // Layer 1 — guide rings, spokes, percentile tick labels
    const ringsG = document.getElementById('radarRings');
    [0.25, 0.5, 0.75, 1].forEach(frac=>{
      ringsG.appendChild(makeEl('polygon', { class:'ring', points: polyPoints(()=>MAX_R*frac) }));
    });
    axes.forEach((_, i)=>{
      const p = pointAt(MAX_R, i);
      ringsG.appendChild(makeEl('line', { class:'spoke', x1:CX, y1:CY, x2:p.x.toFixed(1), y2:p.y.toFixed(1) }));
    });
    [25, 50, 75, 100].forEach(v=>{
      const r = MAX_R * (v/100);
      const t = makeEl('text', { class:'tick-label', x:CX+7, y:(CY-r+3).toFixed(1) });
      t.textContent = v;
      ringsG.appendChild(t);
    });

    // Layer 2 — admissible band (per-axis donut, evenodd fill between bandMin/bandMax)
    const outerPath = pathFor((i)=>MAX_R*(axes[i].bandMax/100));
    const innerPath = pathFor((i)=>MAX_R*(axes[i].bandMin/100));
    document.getElementById('radarBand').setAttribute('d', outerPath + ' ' + innerPath);

    // Layer 3 — athlete profile polygon + vertex markers
    document.getElementById('radarAthletePoly').setAttribute('points', polyPoints((i)=>MAX_R*(axes[i].value/100)));
    const dotsG = document.getElementById('radarAthleteDots');
    axes.forEach((a,i)=>{
      const p = pointAt(MAX_R*(a.value/100), i);
      dotsG.appendChild(makeEl('circle', { class:'athlete-dot', cx:p.x.toFixed(1), cy:p.y.toFixed(1), r:3.5 }));
    });

    // Axis endpoint labels (full + short variants, CSS-toggled by breakpoint)
    const labelsG = document.getElementById('radarLabels');
    axes.forEach((a,i)=>{
      const p = pointAt(LABEL_R, i);
      let anchor = 'middle';
      if(p.cos > 0.3) anchor = 'start';
      else if(p.cos < -0.3) anchor = 'end';
      let dy = 4;
      if(p.sin < -0.7) dy = -2;
      else if(p.sin > 0.7) dy = 10;

      const full = makeEl('text', { class:'axis-label axis-label-full', 'text-anchor':anchor, x:p.x.toFixed(1), y:(p.y+dy).toFixed(1) });
      full.textContent = a.label.toUpperCase();
      labelsG.appendChild(full);

      const short = makeEl('text', { class:'axis-label axis-label-short', 'text-anchor':anchor, x:p.x.toFixed(1), y:(p.y+dy).toFixed(1) });
      short.textContent = a.short.toUpperCase();
      labelsG.appendChild(short);
    });
  })();
</script>
