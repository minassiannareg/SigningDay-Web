---
export const prerender = false;

import Base from '../layouts/Base.astro';
---

<Base title="Reset Password" description="Reset your Signing Day Advisors account password." noindex>

<section class="reset-page">
  <div class="wrap">
    <div class="reset-card">

      <span class="eyebrow">Client Portal</span>
      <h1>Reset Password</h1>
      <p class="reset-intro">Enter a new password for your Signing Day Advisors account.</p>

      <div id="reset-form" class="reset-form" hidden>

        <div class="reset-field">
          <label for="new-password">New Password</label>

          <div class="password-wrap">
            <input id="new-password" type="password" autocomplete="new-password" minlength="6" />
            <button class="password-toggle" type="button" data-target="new-password" aria-label="Show password">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12Zm10 3.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7Z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
          </div>
        </div>

        <div class="reset-field">
          <label for="confirm-password">Confirm Password</label>

          <div class="password-wrap">
            <input id="confirm-password" type="password" autocomplete="new-password" minlength="6" />
            <button class="password-toggle" type="button" data-target="confirm-password" aria-label="Show password">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12Zm10 3.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7Z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
          </div>
        </div>

        <button id="reset-button" class="reset-button" type="button">Update Password</button>

      </div>

      <p id="reset-status" class="reset-status">Verifying your reset link...</p>

    </div>
  </div>
</section>

</Base>

<script>
import { createBrowserSupabaseClient } from '../lib/supabase';

const supabase = createBrowserSupabaseClient();

const form = document.querySelector<HTMLElement>('#reset-form');
const status = document.querySelector<HTMLElement>('#reset-status');
const resetButton = document.querySelector<HTMLButtonElement>('#reset-button');
const password = document.querySelector<HTMLInputElement>('#new-password');
const confirmPassword = document.querySelector<HTMLInputElement>('#confirm-password');

let recoveryReady = false;

const showResetForm = () => {
  recoveryReady = true;
  if (status) status.textContent = '';
  if (form) form.hidden = false;
};

const showInvalidLink = () => {
  recoveryReady = false;
  if (form) form.hidden = true;
  if (status) status.textContent = 'This password reset link is invalid or has expired. Please request a new one.';
};

const prepareRecoverySession = async () => {
  const params = new URLSearchParams(window.location.search);
  const code = params.get('code');

  if (code) {
    const { error } = await supabase.auth.exchangeCodeForSession(code);

    if (error) {
      console.error('PASSWORD RECOVERY CODE ERROR:', error);
      showInvalidLink();
      return;
    }

    window.history.replaceState({}, document.title, window.location.pathname);
    showResetForm();
    return;
  }

  const { data: { session } } = await supabase.auth.getSession();

  if (session) {
    showResetForm();
    return;
  }

  const { data: authListener } = supabase.auth.onAuthStateChange((event, session) => {
    if (event === 'PASSWORD_RECOVERY' && session) {
      showResetForm();
    }
  });

  window.setTimeout(async () => {
    if (recoveryReady) return;

    const { data: { session: delayedSession } } = await supabase.auth.getSession();

    if (delayedSession) {
      showResetForm();
      return;
    }

    authListener.subscription.unsubscribe();
    showInvalidLink();
  }, 1500);
};

prepareRecoverySession();

resetButton?.addEventListener('click', async () => {
  const newPassword = password?.value ?? '';
  const confirmedPassword = confirmPassword?.value ?? '';

  if (!recoveryReady) {
    if (status) status.textContent = 'Your password reset session is not active. Please request a new reset link.';
    return;
  }

  if (newPassword.length < 8) {
    if (status) status.textContent = 'Password must be at least 8 characters.';
    return;
  }

  if (newPassword !== confirmedPassword) {
    if (status) status.textContent = 'Passwords do not match.';
    return;
  }

  resetButton.disabled = true;
  resetButton.textContent = 'Updating...';

  if (status) status.textContent = '';

  const { error } = await supabase.auth.updateUser({
    password: newPassword,
  });

  if (error) {
    resetButton.disabled = false;
    resetButton.textContent = 'Update Password';

    if (status) status.textContent = error.message;

    console.error('PASSWORD UPDATE ERROR:', error);
    return;
  }

  if (form) form.hidden = true;

  if (status) status.textContent = 'Password updated successfully. Redirecting...';

  window.setTimeout(() => {
    window.location.href = '/portal';
  }, 1200);
});

document.querySelectorAll<HTMLButtonElement>('.password-toggle').forEach((button) => {
  button.addEventListener('click', () => {
    const target = button.dataset.target;

    if (!target) return;

    const input = document.querySelector<HTMLInputElement>(`#${target}`);

    if (!input) return;

    const hidden = input.type === 'password';

    input.type = hidden ? 'text' : 'password';
    button.setAttribute('aria-label', hidden ? 'Hide password' : 'Show password');
  });
});
</script>

<style is:global>
.reset-page{min-height:calc(100vh - 72px);background:var(--cream);padding:96px 0}
.reset-card{max-width:520px;margin:0 auto;background:#fff;border:1px solid var(--line);border-radius:8px;padding:42px}
.reset-card .eyebrow{display:block;margin-bottom:12px}
.reset-card h1{font-size:42px;color:var(--navy);margin:0 0 12px}
.reset-intro{color:var(--muted);margin:0 0 30px}
.reset-form{display:flex;flex-direction:column;gap:20px}
.reset-field{display:flex;flex-direction:column;gap:8px}
.reset-field label{font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:1px;text-transform:uppercase;color:var(--navy)}
.password-wrap{position:relative;width:100%}
.password-wrap input{width:100%;height:52px;box-sizing:border-box;background:var(--cream);border:1px solid var(--line);border-radius:2px;padding:13px 52px 13px 14px;font-family:'Newsreader',serif;font-size:16px;color:var(--navy)}
.password-wrap input:focus{outline:none;border-color:var(--gold);background:#fff}
.password-toggle{position:absolute;right:12px;top:50%;transform:translateY(-50%);display:flex;align-items:center;justify-content:center;width:32px;height:32px;padding:0;border:0;background:transparent;color:var(--muted);cursor:pointer}
.password-toggle:hover{color:var(--navy)}
.password-toggle svg{width:21px;height:21px}
.reset-button{width:100%;appearance:none;border:0;border-radius:2px;background:var(--gold);color:var(--navy);padding:15px 28px;font-family:'Newsreader',serif;font-size:15px;font-weight:600;cursor:pointer}
.reset-button:hover{background:var(--gold-soft)}
.reset-button:disabled{opacity:.6;cursor:default}
.reset-status{min-height:22px;margin:18px 0 0;color:var(--muted);font-size:14px}
</style>