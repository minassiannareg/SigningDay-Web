---
export const prerender = false;

import Base from '../layouts/Base.astro';
import { createServerSupabaseClient } from '../lib/supabase';

const supabase = createServerSupabaseClient({ request: Astro.request, cookies: Astro.cookies });

const { data: { user } } = await supabase.auth.getUser();

if (!user) return Astro.redirect('/login');

const { data: roleProfile } = await supabase.from('profiles').select('is_admin').eq('id', user.id).maybeSingle();

if (roleProfile?.is_admin) return Astro.redirect('/admin');

const { data: profile, error: profileError } = await supabase.from('profiles').select('athlete_name, graduation_year, package, best_events, current_school, current_team, monthly_subscription, subscription_status, next_session_at, next_session_link').eq('id', user.id).maybeSingle();

if (profileError) console.error('PROFILE ERROR:', profileError);

const packageName = profile?.package?.toLowerCase() ?? '';
const subscriptionStatus = profile?.subscription_status?.toLowerCase() ?? '';

const categoryLabel = (category?: string | null) => {
  const labels: Record<string, string> = {
    'compass': 'SDA Compass',
    'recruiting-timeline': 'Recruiting Timeline',
    'training-plan': 'Training Plan',
    'nutrition-pamphlet': 'Nutrition Pamphlet',
    'essay-help': 'Essay Help',
    'general-info': 'General Info',
    'network': 'Network',
    'other': 'Other',
    'client-upload': 'Uploaded by You',
  };

  return category ? labels[category.toLowerCase()] ?? category : 'General';
};
const { data: documents, error: documentsError } = await supabase.from('client_documents').select('id, title, category, storage_path, created_at').eq('user_id', user.id).order('created_at', { ascending: false });

if (documentsError) console.error('DOCUMENT ERROR:', documentsError);

const { data: timeline, error: timelineError } = await supabase.from('client_timeline').select('id, title, completed, sort_order').eq('user_id', user.id).order('sort_order', { ascending: true });

if (timelineError) console.error('TIMELINE ERROR:', timelineError);

const { data: clientNote, error: noteError } = await supabase.from('client_notes').select('note_text, updated_at').eq('user_id', user.id).maybeSingle();

if (noteError) console.error('NOTE ERROR:', noteError);

const compassDocument = documents?.find((doc) => doc.category?.toLowerCase() === 'compass');

let compassUrl: string | null = null;

if (compassDocument) {
  const { data: signedData, error: signedUrlError } = await supabase.storage.from('client-files').createSignedUrl(compassDocument.storage_path, 60 * 10);
  if (signedUrlError) console.error('SIGNED URL ERROR:', signedUrlError);
  if (signedData) compassUrl = signedData.signedUrl;
}

const clientMaterials = (documents ?? []).filter((doc) => doc.category?.toLowerCase() !== 'compass');

const materialsWithUrls = await Promise.all(clientMaterials.map(async (doc) => {
  const { data, error } = await supabase.storage.from('client-files').createSignedUrl(doc.storage_path, 60 * 10);
  if (error) console.error('MATERIAL URL ERROR:', error);
  return { ...doc, signedUrl: data?.signedUrl ?? null };
}));

const completedTimelineItems = (timeline ?? []).filter((item) => item.completed).length;
const totalTimelineItems = timeline?.length ?? 0;
---

<Base title="My Portal" description="Secure client access to SDA assessments, package information, and resources." noindex>

<section class="portal-hero">
  <div class="wrap portal-hero-inner">
    <div>
      <span class="eyebrow">Client Portal</span>
      <h1>{profile?.athlete_name ? `Welcome, ${profile.athlete_name}` : 'My Portal'}</h1>
      <p class="portal-intro">Your recruiting information, SDA assessment, and resources in one place.</p>
      <p class="portal-user">Signed in as {user.email}</p>
    </div>
    <button id="logout-button" class="logout-button" type="button">Log Out</button>
  </div>
</section>

<section class="portal-content">
  <div class="wrap">

    <section class="dashboard-section">
      <div class="section-heading">
        <div>
          <span class="section-kicker">Profile</span>
          <h2>Athlete Information</h2>
        </div>
      </div>

      <div class="athlete-grid">
        <div class="info-card">
          <span class="info-label">Package</span>
          <h3>{profile?.package ?? 'Not assigned'}</h3>
        </div>

        <div class="info-card">
          <span class="info-label">College Graduation Year</span>
          <h3>{profile?.graduation_year ?? '—'}</h3>
        </div>

        <div class="info-card">
          <span class="info-label">Best Events</span>
          <h3>{profile?.best_events ?? 'Not added'}</h3>
        </div>

        <div class="info-card">
          <span class="info-label">Current School</span>
          <h3>{profile?.current_school ?? 'Not added'}</h3>
        </div>

        <div class="info-card">
          <span class="info-label">Current Team</span>
          <h3>{profile?.current_team ?? 'Not added'}</h3>
        </div>
      </div>
    </section>

    <section class="dashboard-section">
      <div class="section-heading">
        <div>
          <span class="section-kicker">Your Services</span>
          <h2>What's Included in Your Package</h2>
        </div>
        <p>Your current SDA package and any active add-on services.</p>
      </div>

      <div class="portal-card package-card">
        <div class="card-top">
          <span class="card-label">{profile?.package ?? 'Your Package'}</span>
          <span class="status-badge">Active</span>
        </div>

        {packageName === 'sda compass' && (
          <ul class="package-services">
            <li>SDA Compass assessment</li>
            <li>Academic and athletic benchmarking</li>
            <li>School-by-school positioning</li>
            <li>Recruiting recommendations</li>
          </ul>
        )}

        {packageName === 'base' && (
          <ul class="package-services">
            <li>SDA Compass</li>
            <li>Recruiting timeline & strategy session</li>
            <li>Mock coach recruiting session & official visit preparedness</li>
            <li>Parent strategy session</li>
          </ul>
        )}

        {packageName === 'premium' && (
          <ul class="package-services">
            <li>SDA Compass</li>
            <li>Recruiting timeline & strategy session</li>
            <li>Mock coach recruiting session & official visit preparedness</li>
            <li>Parent strategy session</li>
            <li>Academic strategy session</li>
            <li>Improving athletic performance session</li>
            <li>Essay coaching for Common App & supplements with tracker</li>
            <li>Access to the SDA Network</li>
            <li>Pre-hab, dryland, warm-up & meet-day catalog</li>
            <li>Personalized training toward identified gaps</li>
            <li>Nutrition & fueling educational resources</li>
          </ul>
        )}

        {!['sda compass','base','premium'].includes(packageName) && <p>Your current Signing Day Advisors service package.</p>}

        {profile?.monthly_subscription && (
          <div class="monthly-addon">
            <div class="card-top monthly-top">
              <span class="card-label">Monthly Advisory</span>
              <span class={subscriptionStatus === 'active' ? 'status-badge' : subscriptionStatus === 'past_due' ? 'past-due-badge' : subscriptionStatus === 'canceled' ? 'inactive-badge' : 'pending-badge'}>{subscriptionStatus === 'active' ? 'Active' : subscriptionStatus === 'past_due' ? 'Past Due' : subscriptionStatus === 'canceled' ? 'Canceled' : 'Pending'}</span>
            </div>
            <p>Ongoing Monthly Advisory support is included as an add-on to your current package.</p>
          </div>
        )}
      </div>
    </section>

    <section class="dashboard-section">
      <div class="section-heading timeline-heading">
        <div>
          <span class="section-kicker">Recruiting Journey</span>
          <h2>Recruiting Timeline</h2>
        </div>
        <span id="timeline-progress" class="timeline-progress">{completedTimelineItems} of {totalTimelineItems} complete</span>
      </div>

      <div class="portal-card timeline-card">
        {(timeline ?? []).length > 0 ? (
          <div class="timeline-list">
            {(timeline ?? []).map((item) => (
              <label class:list={['timeline-item', { completed: item.completed }]}>
                <input class="timeline-checkbox" type="checkbox" data-timeline-id={item.id} checked={item.completed} />
                <span class="custom-checkbox"></span>
                <span class="timeline-title">{item.title}</span>
              </label>
            ))}
          </div>
        ) : (
          <div class="empty-state">
            <h3>No Timeline Yet</h3>
            <p>Your recruiting milestones will appear here.</p>
          </div>
        )}

        <p id="timeline-save-status" class="timeline-save-status"></p>
      </div>
    </section>

    <section class="dashboard-section">
      <div class="section-heading">
        <div>
          <span class="section-kicker">Upcoming</span>
          <h2>Next Session</h2>
        </div>
      </div>

      <div class="portal-card session-card">
        {profile?.next_session_at ? (
          <div class="session-layout">
            <div>
              <span class="card-label">Scheduled Session</span>
              <h3 id="next-session-date" data-session-at={profile.next_session_at}>Loading date...</h3>
              <p>Your next scheduled session with Signing Day Advisors.</p>
            </div>

            {profile?.next_session_link && (
              <a class="session-button" href={profile.next_session_link} target="_blank" rel="noopener noreferrer">Join Meeting</a>
            )}
          </div>
        ) : (
          <>
            <span class="card-label">Next Session</span>
            <h3>No Session Scheduled</h3>
            <p>Your next scheduled session will appear here.</p>
          </>
        )}
      </div>
    </section>

    <section class="dashboard-section">
      <div class="section-heading">
        <div>
          <span class="section-kicker">Assessment</span>
          <h2>SDA Compass</h2>
        </div>
      </div>

      <div class="portal-card compass-card">
        {compassDocument && compassUrl ? (
          <>
            <div class="card-top">
              <span class="card-label">{compassDocument.title}</span>
              <span class="status-badge">Ready</span>
            </div>
            <h3>Your completed assessment is available.</h3>
            <p>Open your SDA Compass to review your positioning and recruiting insights.</p>
            <a class="portal-button" href={compassUrl} target="_blank" rel="noopener noreferrer">View SDA Compass</a>
          </>
        ) : (
          <>
            <div class="card-top">
              <span class="card-label">SDA Compass</span>
              <span class="pending-badge">Pending</span>
            </div>
            <h3>Not Available Yet</h3>
            <p>Your completed SDA Compass will appear here once it has been uploaded.</p>
          </>
        )}
      </div>
    </section>

    <section class="dashboard-section">
      <div class="section-heading">
        <div>
          <span class="section-kicker">Share With SDA</span>
          <h2>Upload Files</h2>
        </div>
        <p>Upload documents or files you would like to share with the SDA team.</p>
      </div>

      <div class="portal-card upload-card">
        <div class="client-upload-grid">
          <div class="upload-field">
            <label for="client-upload-title">File Title</label>
            <input id="client-upload-title" type="text" placeholder="e.g. Latest Meet Results" />
          </div>

          <div class="upload-field">
            <label for="client-upload-file">Choose File</label>
            <input id="client-upload-file" type="file" accept=".pdf,.doc,.docx,.xls,.xlsx,.png,.jpg,.jpeg,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,image/png,image/jpeg" />
          </div>
        </div>

        <div class="client-upload-actions">
          <button id="client-upload-button" class="portal-button upload-button" type="button">Upload File</button>
          <span id="client-upload-status" class="client-upload-status"></span>
        </div>

        <p class="upload-help">Accepted formats: PDF, Word, Excel, PNG and JPG. Maximum file size: 10 MB.</p>
      </div>
    </section>

    <section id="materials" class="dashboard-section">
      <div class="section-heading">
        <div>
          <span class="section-kicker">Resources</span>
          <h2>Client Materials</h2>
        </div>
        <span class="document-count">{materialsWithUrls.length} {materialsWithUrls.length === 1 ? 'file' : 'files'}</span>
      </div>

      <div class="portal-card materials-card">
        {materialsWithUrls.length > 0 ? (
          <div class="materials-list">
            {materialsWithUrls.map((doc) => (
              <div class="material-item" data-document-id={doc.id} data-storage-path={doc.storage_path} data-client-upload={doc.category?.toLowerCase() === 'client-upload' ? 'true' : 'false'}>
                <div class="material-info">
                  <div class="file-icon">{doc.category?.toLowerCase() === 'client-upload' ? 'FILE' : 'SDA'}</div>
                  <div>
                    <h3>{doc.title}</h3>
                    <p class="material-category">{categoryLabel(doc.category)}</p>
                  </div>
                </div>

                <div class="material-actions">
                  {doc.signedUrl && <a class="material-link" href={doc.signedUrl} target="_blank" rel="noopener noreferrer">View</a>}
                  {doc.category?.toLowerCase() === 'client-upload' && <button class="delete-client-file" type="button">Delete</button>}
                </div>
              </div>
            ))}
          </div>
        ) : (
          <div class="empty-state">
            <h3>No Materials Yet</h3>
            <p>Resources shared with you and files you upload will appear here.</p>
          </div>
        )}
      </div>
    </section>

    <section class="dashboard-section">
      <div class="section-heading">
        <div>
          <span class="section-kicker">Personal Workspace</span>
          <h2>My Notes</h2>
        </div>
        <span id="notes-status" class="notes-status"></span>
      </div>

      <div class="portal-card notes-card">
        <p class="notes-description">Use this space for questions, reminders, recruiting thoughts, or anything you want to keep track of. Your notes save automatically.</p>
        <textarea id="client-notes" class="notes-textarea" placeholder="Start typing your notes here...">{clientNote?.note_text ?? ''}</textarea>
      </div>
    </section>

    <section class="dashboard-section">
      <div class="section-heading">
        <div>
          <span class="section-kicker">Account</span>
          <h2>Account Controls</h2>
        </div>
      </div>

      <div class="portal-card account-card">
        <div class="account-row">
          <div>
            <span class="account-label">Email</span>
            <p class="account-value">{user.email}</p>
          </div>
        </div>

        <div class="account-actions">
          <button id="change-password-button" class="account-button" type="button">Change Password</button>
          <button id="account-logout-button" class="account-button secondary" type="button">Log Out</button>
        </div>

        <p id="account-status" class="account-status"></p>
      </div>
    </section>

  </div>
</section>

</Base>

<script>
import { actions } from 'astro:actions';
import { createBrowserSupabaseClient } from '../lib/supabase';

const supabase = createBrowserSupabaseClient();

const logoutButton = document.querySelector<HTMLButtonElement>('#logout-button');

if (logoutButton) {
  logoutButton.addEventListener('click', async () => {
    logoutButton.disabled = true;
    logoutButton.textContent = 'Logging out...';
    const result = await actions.signOut();

    if (result.error || !result.data?.success) {
      logoutButton.disabled = false;
      logoutButton.textContent = 'Log Out';
      alert('There was a problem logging out. Please try again.');
      return;
    }

    window.location.href = '/login';
  });
}

const timelineCheckboxes = document.querySelectorAll<HTMLInputElement>('.timeline-checkbox');
const timelineStatus = document.getElementById('timeline-save-status');
const timelineProgress = document.getElementById('timeline-progress');

timelineCheckboxes.forEach((checkbox) => {
  checkbox.addEventListener('change', async () => {
    const timelineId = checkbox.dataset.timelineId;
    const timelineItem = checkbox.closest('.timeline-item');

    if (!timelineId) return;

    checkbox.disabled = true;
    if (timelineStatus) timelineStatus.textContent = 'Saving...';

    const { error } = await supabase.from('client_timeline').update({ completed: checkbox.checked }).eq('id', timelineId);

    checkbox.disabled = false;

    if (error) {
      checkbox.checked = !checkbox.checked;
      if (timelineStatus) timelineStatus.textContent = 'Could not save. Please try again.';
      return;
    }

    timelineItem?.classList.toggle('completed', checkbox.checked);

    if (timelineStatus) timelineStatus.textContent = 'Saved';

    const completedCount = document.querySelectorAll<HTMLInputElement>('.timeline-checkbox:checked').length;
    const totalCount = document.querySelectorAll<HTMLInputElement>('.timeline-checkbox').length;

    if (timelineProgress) timelineProgress.textContent = `${completedCount} of ${totalCount} complete`;

    window.setTimeout(() => {
      if (timelineStatus?.textContent === 'Saved') timelineStatus.textContent = '';
    }, 1500);
  });
});

const nextSessionDate = document.getElementById('next-session-date');

if (nextSessionDate) {
  const sessionAt = nextSessionDate.dataset.sessionAt;

  if (sessionAt) {
    const sessionDate = new Date(sessionAt);
    nextSessionDate.textContent = sessionDate.toLocaleString(undefined, { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric', hour: 'numeric', minute: '2-digit' });
  }
}

const uploadTitle = document.querySelector<HTMLInputElement>('#client-upload-title');
const uploadFile = document.querySelector<HTMLInputElement>('#client-upload-file');
const uploadButton = document.querySelector<HTMLButtonElement>('#client-upload-button');
const uploadStatus = document.querySelector<HTMLElement>('#client-upload-status');

uploadButton?.addEventListener('click', async () => {
  const title = uploadTitle?.value.trim();
  const file = uploadFile?.files?.[0];

  if (!title) {
    if (uploadStatus) uploadStatus.textContent = 'Enter a file title.';
    return;
  }

  if (!file) {
    if (uploadStatus) uploadStatus.textContent = 'Choose a file.';
    return;
  }

  const allowedTypes = ['application/pdf','application/msword','application/vnd.openxmlformats-officedocument.wordprocessingml.document','application/vnd.ms-excel','application/vnd.openxmlformats-officedocument.spreadsheetml.sheet','image/png','image/jpeg'];

  if (!allowedTypes.includes(file.type)) {
    if (uploadStatus) uploadStatus.textContent = 'Unsupported file type.';
    return;
  }

  if (file.size > 10 * 1024 * 1024) {
    if (uploadStatus) uploadStatus.textContent = 'File must be under 10 MB.';
    return;
  }

  uploadButton.disabled = true;
  uploadButton.textContent = 'Uploading...';

  if (uploadStatus) uploadStatus.textContent = '';

  const { data: { user } } = await supabase.auth.getUser();

  if (!user) {
    uploadButton.disabled = false;
    uploadButton.textContent = 'Upload File';
    if (uploadStatus) uploadStatus.textContent = 'Your session has expired.';
    return;
  }

  const safeFileName = file.name.replace(/[^a-zA-Z0-9._-]/g, '-');
  const storagePath = `${user.id}/uploads/${Date.now()}-${safeFileName}`;

  const { error: uploadError } = await supabase.storage.from('client-files').upload(storagePath, file, { contentType: file.type, upsert: false });

  if (uploadError) {
    uploadButton.disabled = false;
    uploadButton.textContent = 'Upload File';
    if (uploadStatus) uploadStatus.textContent = 'Upload failed.';
    console.error('CLIENT FILE UPLOAD ERROR:', uploadError);
    return;
  }

  const { error: databaseError } = await supabase.from('client_documents').insert({ user_id: user.id, title, category: 'client-upload', storage_path: storagePath });

  if (databaseError) {
    await supabase.storage.from('client-files').remove([storagePath]);
    uploadButton.disabled = false;
    uploadButton.textContent = 'Upload File';
    if (uploadStatus) uploadStatus.textContent = 'Could not save file.';
    console.error('CLIENT DOCUMENT INSERT ERROR:', databaseError);
    return;
  }

  if (uploadStatus) uploadStatus.textContent = 'Uploaded.';
  if (uploadTitle) uploadTitle.value = '';
  if (uploadFile) uploadFile.value = '';

  window.setTimeout(() => {
    window.location.reload();
  }, 700);
});

document.querySelectorAll<HTMLElement>('.material-item[data-client-upload="true"]').forEach((row) => {
  const deleteButton = row.querySelector<HTMLButtonElement>('.delete-client-file');
  const documentId = row.dataset.documentId;
  const storagePath = row.dataset.storagePath;

  if (!deleteButton || !documentId || !storagePath) return;

  deleteButton.addEventListener('click', async () => {
    if (!window.confirm('Delete this file?')) return;

    deleteButton.disabled = true;
    deleteButton.textContent = 'Deleting...';

    const { error: storageError } = await supabase.storage.from('client-files').remove([storagePath]);

    if (storageError) {
      deleteButton.disabled = false;
      deleteButton.textContent = 'Delete';
      alert('Could not delete the file.');
      console.error('CLIENT STORAGE DELETE ERROR:', storageError);
      return;
    }

    const { error: databaseError } = await supabase.from('client_documents').delete().eq('id', documentId);

    if (databaseError) {
      deleteButton.disabled = false;
      deleteButton.textContent = 'Delete';
      alert('The file was removed from storage, but its record could not be deleted.');
      console.error('CLIENT DOCUMENT DELETE ERROR:', databaseError);
      return;
    }

    row.remove();
  });
});

const notesTextarea = document.querySelector<HTMLTextAreaElement>('#client-notes');
const notesStatus = document.getElementById('notes-status');

let notesSaveTimer: ReturnType<typeof setTimeout> | undefined;

if (notesTextarea) {
  notesTextarea.addEventListener('input', () => {
    if (notesStatus) notesStatus.textContent = 'Unsaved changes';

    window.clearTimeout(notesSaveTimer);

    notesSaveTimer = window.setTimeout(async () => {
      if (notesStatus) notesStatus.textContent = 'Saving...';

      const { error } = await supabase.from('client_notes').upsert({ user_id: (await supabase.auth.getUser()).data.user?.id, note_text: notesTextarea.value, updated_at: new Date().toISOString() }, { onConflict: 'user_id' });

      if (error) {
        if (notesStatus) notesStatus.textContent = 'Could not save';
        console.error('NOTE SAVE ERROR:', error);
        return;
      }

      if (notesStatus) notesStatus.textContent = 'Saved';

      window.setTimeout(() => {
        if (notesStatus?.textContent === 'Saved') notesStatus.textContent = '';
      }, 1500);
    }, 800);
  });
}

const changePasswordButton = document.querySelector<HTMLButtonElement>('#change-password-button');
const accountLogoutButton = document.querySelector<HTMLButtonElement>('#account-logout-button');
const accountStatus = document.getElementById('account-status');

if (changePasswordButton) {
  changePasswordButton.addEventListener('click', async () => {
    const { data: { user } } = await supabase.auth.getUser();

    if (!user?.email) return;

    if (accountStatus) accountStatus.textContent = 'Sending password reset email...';

  const result = await actions.sendPasswordReset();

  if (result.error || !result.data?.success) {
    if (accountStatus) accountStatus.textContent = result.data?.message ?? 'Could not send reset email.';
    return;
  }

  if (accountStatus) accountStatus.textContent = result.data.message;
  });
}

if (accountLogoutButton) {
  accountLogoutButton.addEventListener('click', async () => {
    const result = await actions.signOut();

    if (result.error || !result.data?.success) {
      if (accountStatus) accountStatus.textContent = 'Could not log out.';
      return;
    }

    window.location.href = '/login';
  });
}
</script>

<style is:global>
.account-card{display:flex;flex-direction:column;gap:24px}
.account-row{padding-bottom:20px;border-bottom:1px solid var(--line)}
.account-label{display:block;font-family:'IBM Plex Mono',monospace;font-size:9px;letter-spacing:1.3px;text-transform:uppercase;color:var(--muted);margin-bottom:8px}
.account-value{margin:0;color:var(--navy);font-size:17px}
.account-actions{display:flex;gap:12px;flex-wrap:wrap}
.account-button{appearance:none;border:0;background:var(--navy);color:#fff;padding:11px 18px;border-radius:4px;font-family:inherit;font-size:14px;font-weight:600;cursor:pointer}
.account-button:hover{background:var(--gold);color:var(--navy)}
.account-button.secondary{background:transparent;color:var(--navy);border:1px solid var(--line)}
.account-button.secondary:hover{border-color:var(--gold);background:var(--cream)}
.account-status{margin:0!important;font-family:'IBM Plex Mono',monospace;font-size:9px!important;letter-spacing:1px;text-transform:uppercase;color:var(--gold)!important}
.notes-card{padding:28px}
.notes-description{color:var(--muted);font-size:15px;line-height:1.6;margin:0 0 18px}
.notes-textarea{width:100%;min-height:220px;resize:vertical;background:var(--cream);border:1px solid var(--line);border-radius:5px;padding:18px;font-family:inherit;font-size:16px;line-height:1.6;color:var(--navy);box-sizing:border-box}
