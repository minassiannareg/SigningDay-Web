---
export const prerender = false;

import Base from '../layouts/Base.astro';
import { createServerSupabaseClient } from '../lib/supabase';
import { createClient } from '@supabase/supabase-js';

const supabase = createServerSupabaseClient({ request: Astro.request, cookies: Astro.cookies });

const { data: { user } } = await supabase.auth.getUser();

if (!user) return Astro.redirect('/login');

const { data: adminProfile, error: adminProfileError } = await supabase.from('profiles').select('is_admin').eq('id', user.id).maybeSingle();

if (adminProfileError) console.error('ADMIN PROFILE ERROR:', adminProfileError);

if (!adminProfile?.is_admin) return Astro.redirect('/portal');

const { data: clients, error: clientsError } = await supabase.from('profiles').select('id, athlete_name, graduation_year, package, best_events, current_school, current_team, monthly_subscription, subscription_status, next_session_at, next_session_link, is_admin, archived').eq('is_admin', false).order('archived', { ascending: true }).order('athlete_name', { ascending: true });

if (clientsError) console.error('CLIENT LOAD ERROR:', clientsError);

const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL;
const serviceRoleKey = import.meta.env.SUPABASE_SERVICE_ROLE_KEY;

const adminSupabase = createClient(supabaseUrl, serviceRoleKey, {
  auth: {
    autoRefreshToken: false,
    persistSession: false,
  },
});

const { data: authUsers, error: authUsersError } = await adminSupabase.auth.admin.listUsers();

if (authUsersError) console.error('AUTH USERS ERROR:', authUsersError);

const emailByUser = new Map<string, string>();

for (const authUser of authUsers?.users ?? []) {
  if (authUser.email) emailByUser.set(authUser.id, authUser.email);
}

const { data: timelines, error: timelinesError } = await supabase.from('client_timeline').select('id, user_id, title, completed, sort_order').order('sort_order', { ascending: true });

if (timelinesError) console.error('TIMELINE LOAD ERROR:', timelinesError);

const { data: documents, error: documentsError } = await supabase.from('client_documents').select('id, user_id, title, category, storage_path, created_at').order('created_at', { ascending: false });

if (documentsError) console.error('DOCUMENT LOAD ERROR:', documentsError);

const { data: notes, error: notesError } = await supabase.from('client_notes').select('user_id, note_text, updated_at');

if (notesError) console.error('NOTES LOAD ERROR:', notesError);

const timelineByUser = new Map<string, any[]>();

for (const item of timelines ?? []) {
  const existing = timelineByUser.get(item.user_id) ?? [];
  existing.push(item);
  timelineByUser.set(item.user_id, existing);
}

const categoryLabel = (category?: string | null) => {
  const labels: Record<string, string> = {
    'compass': 'SDA Compass',
    'recruiting-timeline': 'Recruiting Timeline',
    'training-plan': 'Training Plan',
    'nutrition-pamphlet': 'Nutrition Pamphlet',
    'essay-help': 'Essay Help',
    'general-info': 'General Info',
    'network': 'Network',
    'other': 'Other',
    'client-upload': 'Uploaded by Client',
  };

  return category ? labels[category.toLowerCase()] ?? category : 'General';
};

const documentsByUser = new Map<string, any[]>();

for (const doc of documents ?? []) {
  const existing = documentsByUser.get(doc.user_id) ?? [];
  const { data: signedData } = await supabase.storage.from('client-files').createSignedUrl(doc.storage_path, 60 * 10);

  existing.push({
    ...doc,
    signedUrl: signedData?.signedUrl ?? null,
  });

  documentsByUser.set(doc.user_id, existing);
}

const notesByUser = new Map<string, any>();

for (const note of notes ?? []) notesByUser.set(note.user_id, note);
---

<Base title="Admin Dashboard" description="Signing Day Advisors client administration." noindex>

<section class="admin-hero">
  <div class="wrap admin-hero-inner">

    <div>
      <span class="eyebrow">SDA Administration</span>
      <h1>Client Dashboard</h1>
      <p>Create and manage athlete accounts, timelines, sessions, documents, and resources.</p>
    </div>

    <button id="admin-logout-button" class="admin-logout-button" type="button">Log Out</button>

  </div>
</section>

<section class="admin-content">
  <div class="wrap">

    <div class="create-client-card">

      <div class="create-client-heading">
        <span class="section-kicker">New Client</span>
        <h2>Create Client Account</h2>
        <p>Create an athlete's portal and assign their initial login password.</p>
      </div>

      <div class="create-client-grid">

        <div class="admin-field">
          <label>Athlete Name *</label>
          <input id="new-athlete-name" type="text" placeholder="Athlete name" />
        </div>

        <div class="admin-field">
          <label>Email *</label>
          <input id="new-client-email" type="email" placeholder="athlete@email.com" autocomplete="email" />
        </div>

        <div class="admin-field">
          <label>Initial Password *</label>

          <div class="password-admin-wrap">
            <input id="new-client-password" type="password" placeholder="Create initial password" minlength="8" autocomplete="new-password" />
            <button id="toggle-new-password" class="password-small-button" type="button">Show</button>
            <button id="copy-new-password" class="password-small-button" type="button">Copy</button>
          </div>
        </div>

        <div class="admin-field">
          <label>Graduation Year</label>
          <input id="new-graduation-year" type="number" placeholder="2028" />
        </div>

        <div class="admin-field">
          <label>Package</label>

          <select id="new-package">
            <option value="">Select package</option>
            <option value="SDA Compass">SDA Compass</option>
            <option value="Base">Base</option>
            <option value="Premium">Premium</option>
          </select>
        </div>

        <div class="admin-field">
          <label>Best Events</label>
          <input id="new-best-events" type="text" placeholder="e.g. 100 Free, 200 Free" />
        </div>

        <div class="admin-field">
          <label>Current School</label>
          <input id="new-current-school" type="text" placeholder="School" />
        </div>

        <div class="admin-field">
          <label>Current Team</label>
          <input id="new-current-team" type="text" placeholder="Team / club" />
        </div>

        <div class="admin-field">
          <label>Monthly Advisory</label>

          <label class="toggle-row">
            <input id="new-monthly-subscription" type="checkbox" />
            <span>Client has Monthly Advisory</span>
          </label>
        </div>

      </div>

      <div class="create-client-actions">
        <button id="create-client-button" type="button">Create Client</button>
        <span id="create-client-status"></span>
      </div>

      <div id="created-credentials" class="created-credentials" hidden>

        <div class="credentials-heading">
          <div>
            <span class="section-kicker">Account Created</span>
            <h3>Client Login Details</h3>
          </div>

          <span class="one-time-badge">Copy Before Refreshing</span>
        </div>

        <div class="credential-row">
          <span class="credential-label">Email</span>
          <strong id="created-email"></strong>
          <button id="copy-created-email" type="button">Copy</button>
        </div>

        <div class="credential-row">
          <span class="credential-label">Temporary Password</span>
          <strong id="created-password"></strong>
          <button id="copy-created-password" type="button">Copy</button>
        </div>

        <div class="credentials-actions">
          <button id="copy-all-credentials" type="button">Copy Login Information</button>
          <button id="refresh-after-create" class="secondary-credentials-button" type="button">Refresh Client List</button>
        </div>

        <p class="credentials-note">Copy these details into the client's welcome email. For security, the temporary password is not stored in readable form after this page is refreshed.</p>

      </div>

    </div>

    <div class="admin-heading">

      <div>
        <span class="section-kicker">Clients</span>
        <h2>Manage Athletes</h2>
      </div>

      <span class="client-count">{clients?.length ?? 0} {(clients?.length ?? 0) === 1 ? 'client' : 'clients'}</span>

    </div>

    <div class="client-list">

      {(clients ?? []).map((client) => {
        const clientTimeline = timelineByUser.get(client.id) ?? [];
        const clientDocuments = documentsByUser.get(client.id) ?? [];
        const clientNote = notesByUser.get(client.id);

        return (
          <details class:list={['client-card', { archived: client.archived }]} data-client-id={client.id}>

            <summary class="client-summary">

              <div class="client-summary-info">
                <span class="client-label">Athlete</span>

                <div class="client-name-row">
                  <h3>{client.athlete_name ?? 'Unnamed Client'}</h3>
                  <span class="client-email">{emailByUser.get(client.id) ?? ''}</span>
                </div>
              </div>

              <div class="client-summary-right">
                <span class={client.archived ? 'archive-badge' : 'active-client-badge'}>{client.archived ? 'Archived' : 'Active'}</span>
                <span class="package-badge">{client.package ?? 'No Package'}</span>
                <span class="client-arrow">⌄</span>
              </div>

            </summary>

            <div class="client-details">

              <div class="admin-section-title">Profile Information</div>

              <div class="admin-form-grid">

                <div class="admin-field">
                  <label>Athlete Name</label>
                  <input data-field="athlete_name" type="text" value={client.athlete_name ?? ''} />
                </div>

                <div class="admin-field">
                  <label>Email</label>
                  <input type="email" value={emailByUser.get(client.id) ?? ''} disabled />
                </div>

                <div class="admin-field">
                  <label>Graduation Year</label>
                  <input data-field="graduation_year" type="number" value={client.graduation_year ?? ''} />
                </div>

                <div class="admin-field">
                  <label>Package</label>

                  <select data-field="package">
                    <option value="">Select package</option>
                    <option value="SDA Compass" selected={client.package === 'SDA Compass'}>SDA Compass</option>
                    <option value="Base" selected={client.package === 'Base'}>Base</option>
                    <option value="Premium" selected={client.package === 'Premium'}>Premium</option>
                  </select>
                </div>

                <div class="admin-field">
                  <label>Best Events</label>
                  <input data-field="best_events" type="text" value={client.best_events ?? ''} />
                </div>

                <div class="admin-field">
                  <label>Current School</label>
                  <input data-field="current_school" type="text" value={client.current_school ?? ''} />
                </div>

                <div class="admin-field">
                  <label>Current Team</label>
                  <input data-field="current_team" type="text" value={client.current_team ?? ''} />
                </div>

                <div class="admin-field">
                  <label>Account Status</label>

                  <label class="toggle-row">
                    <input class="archive-toggle" type="checkbox" checked={!client.archived} />
                    <span class="archive-status">{client.archived ? 'Archived' : 'Active'}</span>
                  </label>
                </div>

                <div class="admin-field">
                  <label>Initial Password</label>
                  <div class="stored-password-message">Temporary password not stored for security</div>
                </div>

                <div class="admin-field">
                  <label>Monthly Advisory</label>

                  <label class="toggle-row">
                    <input data-field="monthly_subscription" type="checkbox" checked={client.monthly_subscription ?? false} />
                    <span>Client has Monthly Advisory</span>
                  </label>
                </div>

                <div class="admin-field">
                  <label>Subscription Status</label>

                  <select data-field="subscription_status">
                    <option value="">Not applicable</option>
                    <option value="active" selected={client.subscription_status === 'active'}>Active</option>
                    <option value="past_due" selected={client.subscription_status === 'past_due'}>Past Due</option>
                    <option value="canceled" selected={client.subscription_status === 'canceled'}>Canceled</option>
                  </select>
                </div>

                <div class="admin-field">
                  <label>Next Session</label>
                  <input data-field="next_session_at" type="datetime-local" value={client.next_session_at ? new Date(client.next_session_at).toISOString().slice(0,16) : ''} />
                </div>

                <div class="admin-field">
                  <label>Meeting Link</label>
                  <input data-field="next_session_link" type="url" value={client.next_session_link ?? ''} placeholder="https://..." />
                </div>

              </div>

              <div class="client-actions">
                <button class="save-client-button" type="button">Save Profile Changes</button>
                <span class="save-status"></span>
              </div>

              <div class="admin-subsection">

                <div class="admin-section-heading">

                  <div>
                    <span class="admin-section-kicker">Recruiting Journey</span>
                    <h4>Recruiting Timeline</h4>
                  </div>

                  <span class="timeline-count">{clientTimeline.filter((item) => item.completed).length} of {clientTimeline.length} complete</span>

                </div>

                <div class="admin-timeline-list">

                  {clientTimeline.length > 0 ? clientTimeline.map((item) => (
                    <div class="admin-timeline-row" data-timeline-id={item.id}>
                      <input class="admin-timeline-checkbox" type="checkbox" checked={item.completed} />
                      <input class="admin-timeline-title" type="text" value={item.title} />
                      <span class="timeline-row-status"></span>
                      <button class="delete-timeline-button" type="button">Delete</button>
                    </div>
                  )) : (
                    <p class="empty-admin-message">No timeline milestones have been added yet.</p>
                  )}

                </div>

                <div class="add-timeline-row">
                  <input class="new-timeline-input" type="text" placeholder="Add a new milestone..." />
                  <button class="add-timeline-button" type="button">Add Milestone</button>
                </div>

                <p class="timeline-admin-status"></p>

              </div>

              <div class="admin-subsection">

                <div class="admin-section-heading">

                  <div>
                    <span class="admin-section-kicker">Files</span>
                    <h4>Compass & Client Resources</h4>
                  </div>

                  <span class="document-count">{clientDocuments.length} {clientDocuments.length === 1 ? 'file' : 'files'}</span>

                </div>

                <div class="admin-document-list">

                  {clientDocuments.length > 0 ? clientDocuments.map((doc) => (
                    <div class="admin-document-row" data-document-id={doc.id} data-storage-path={doc.storage_path}>

                      <div class="document-info">

                        <span class="document-type">{doc.category?.toLowerCase() === 'compass' ? 'Compass' : doc.category?.toLowerCase() === 'client-upload' ? 'Client' : 'Resource'}</span>

                        <div>
                          <h5>{doc.title}</h5>
                          <p>{categoryLabel(doc.category)}</p>
                        </div>

                      </div>

                      <div class="document-actions">
                        {doc.signedUrl && <a class="view-document-button" href={doc.signedUrl} target="_blank" rel="noopener noreferrer">View</a>}
                        <button class="delete-document-button" type="button">Delete</button>
                      </div>

                    </div>
                  )) : (
                    <p class="empty-admin-message">No files have been uploaded for this client yet.</p>
                  )}

                </div>

                <div class="upload-panel">

                  <div class="admin-field">
                    <label>Document Title</label>
                    <input class="upload-title" type="text" placeholder="e.g. SDA Compass" />
                  </div>

                  <div class="admin-field">
                    <label>Category</label>

                    <select class="upload-category">
                      <option value="compass">SDA Compass</option>
                      <option value="recruiting-timeline">Recruiting Timeline</option>
                      <option value="training-plan">Training Plan</option>
                      <option value="nutrition-pamphlet">Nutrition Pamphlet</option>
                      <option value="essay-help">Essay Help</option>
                      <option value="general-info">General Info</option>
                      <option value="network">Network</option>
                      <option value="other">Other</option>
                    </select>
                  </div>

                  <div class="admin-field">
                    <label>PDF File</label>
                    <input class="upload-file" type="file" accept=".pdf,application/pdf" />
                  </div>

                  <div class="upload-actions">
                    <button class="upload-document-button" type="button">Upload Document</button>
                    <span class="upload-status"></span>
                  </div>

                </div>

              </div>

              <div class="admin-subsection">

                <div class="admin-section-heading">

                  <div>
                    <span class="admin-section-kicker">Shared Workspace</span>
                    <h4>Shared Notes</h4>
                  </div>

                  <span class="shared-note-status"></span>

                </div>

                <p class="shared-note-description">Shared notes between SDA and the client. Changes made here will also appear in the client's portal.</p>

                <textarea class="admin-shared-notes" placeholder="Add a note for the client...">{clientNote?.note_text ?? ''}</textarea>

              </div>

            </div>

          </details>
        );
      })}

    </div>

  </div>
</section>

</Base>

<script>
import { createBrowserSupabaseClient } from '../lib/supabase';
import { actions } from 'astro:actions';

const supabase = createBrowserSupabaseClient();

const createClientButton = document.querySelector<HTMLButtonElement>('#create-client-button');
const createClientStatus = document.querySelector<HTMLElement>('#create-client-status');

const newPasswordInput = document.querySelector<HTMLInputElement>('#new-client-password');
const toggleNewPassword = document.querySelector<HTMLButtonElement>('#toggle-new-password');
const copyNewPassword = document.querySelector<HTMLButtonElement>('#copy-new-password');

const credentialsBox = document.querySelector<HTMLElement>('#created-credentials');
const createdEmail = document.querySelector<HTMLElement>('#created-email');
const createdPassword = document.querySelector<HTMLElement>('#created-password');
const copyCreatedEmail = document.querySelector<HTMLButtonElement>('#copy-created-email');
const copyCreatedPassword = document.querySelector<HTMLButtonElement>('#copy-created-password');
const copyAllCredentials = document.querySelector<HTMLButtonElement>('#copy-all-credentials');
const refreshAfterCreate = document.querySelector<HTMLButtonElement>('#refresh-after-create');

toggleNewPassword?.addEventListener('click', () => {
  if (!newPasswordInput) return;

  const hidden = newPasswordInput.type === 'password';

  newPasswordInput.type = hidden ? 'text' : 'password';
  toggleNewPassword.textContent = hidden ? 'Hide' : 'Show';
});

copyNewPassword?.addEventListener('click', async () => {
  if (!newPasswordInput?.value) return;

  await navigator.clipboard.writeText(newPasswordInput.value);

  copyNewPassword.textContent = 'Copied';

  window.setTimeout(() => {
    copyNewPassword.textContent = 'Copy';
  }, 1200);
});

copyCreatedEmail?.addEventListener('click', async () => {
  if (!createdEmail?.textContent) return;

  await navigator.clipboard.writeText(createdEmail.textContent);

  copyCreatedEmail.textContent = 'Copied';

  window.setTimeout(() => {
    copyCreatedEmail.textContent = 'Copy';
  }, 1200);
});

copyCreatedPassword?.addEventListener('click', async () => {
  if (!createdPassword?.textContent) return;

  await navigator.clipboard.writeText(createdPassword.textContent);

  copyCreatedPassword.textContent = 'Copied';

  window.setTimeout(() => {
    copyCreatedPassword.textContent = 'Copy';
  }, 1200);
});

copyAllCredentials?.addEventListener('click', async () => {
  const email = createdEmail?.textContent ?? '';
  const password = createdPassword?.textContent ?? '';

  if (!email || !password) return;

  const text = `Signing Day Advisors Client Portal\nLogin: https://signingdayadvisors.com/login\nEmail: ${email}\nTemporary Password: ${password}`;

  await navigator.clipboard.writeText(text);

  copyAllCredentials.textContent = 'Copied';

  window.setTimeout(() => {
    copyAllCredentials.textContent = 'Copy Login Information';
  }, 1400);
});

refreshAfterCreate?.addEventListener('click', () => {
  window.location.reload();
});

createClientButton?.addEventListener('click', async () => {
  const athleteName = document.querySelector<HTMLInputElement>('#new-athlete-name');
  const email = document.querySelector<HTMLInputElement>('#new-client-email');
  const password = document.querySelector<HTMLInputElement>('#new-client-password');
  const graduationYear = document.querySelector<HTMLInputElement>('#new-graduation-year');
  const packageInput = document.querySelector<HTMLSelectElement>('#new-package');
  const bestEvents = document.querySelector<HTMLInputElement>('#new-best-events');
  const currentSchool = document.querySelector<HTMLInputElement>('#new-current-school');
  const currentTeam = document.querySelector<HTMLInputElement>('#new-current-team');
  const monthlySubscription = document.querySelector<HTMLInputElement>('#new-monthly-subscription');

  if (!athleteName?.value.trim()) {
    if (createClientStatus) createClientStatus.textContent = 'Enter the athlete name.';
    return;
  }

  if (!email?.value.trim()) {
    if (createClientStatus) createClientStatus.textContent = 'Enter an email address.';
    return;
  }

  if (!password?.value || password.value.length < 8) {
    if (createClientStatus) createClientStatus.textContent = 'Password must be at least 8 characters.';
    return;
  }

  const initialPassword = password.value;
  const clientEmail = email.value.trim();

  createClientButton.disabled = true;
  createClientButton.textContent = 'Creating...';

  if (createClientStatus) createClientStatus.textContent = '';

  const result = await actions.createClient({
    email: clientEmail,
    password: initialPassword,
    athleteName: athleteName.value.trim(),
    graduationYear: graduationYear?.value ? Number(graduationYear.value) : undefined,
    package: packageInput?.value ? packageInput.value as 'SDA Compass' | 'Base' | 'Premium' : undefined,
    bestEvents: bestEvents?.value.trim() || undefined,
    currentSchool: currentSchool?.value.trim() || undefined,
    currentTeam: currentTeam?.value.trim() || undefined,
    monthlySubscription: monthlySubscription?.checked ?? false,
  });

  createClientButton.disabled = false;
  createClientButton.textContent = 'Create Client';

  if (result.error) {
    if (createClientStatus) createClientStatus.textContent = result.error.message ?? 'Could not create client.';

    console.error('CREATE CLIENT ACTION ERROR:', result.error);

    return;
  }

  if (!result.data?.success) {
    if (createClientStatus) createClientStatus.textContent = result.data?.message ?? 'Could not create client.';
    return;
  }

  if (createClientStatus) createClientStatus.textContent = result.data.message;

  if (createdEmail) createdEmail.textContent = clientEmail;
  if (createdPassword) createdPassword.textContent = initialPassword;

  if (credentialsBox) credentialsBox.hidden = false;

  if (password) {
    password.type = 'text';
    password.value = initialPassword;
  }

  if (toggleNewPassword) toggleNewPassword.textContent = 'Hide';

  credentialsBox?.scrollIntoView({
    behavior: 'smooth',
    block: 'nearest',
  });
});

document.querySelectorAll<HTMLElement>('.client-card').forEach((card) => {
  const clientId = card.dataset.clientId;

  if (!clientId) return;

  const sharedNotes = card.querySelector<HTMLTextAreaElement>('.admin-shared-notes');
  const sharedNoteStatus = card.querySelector<HTMLElement>('.shared-note-status');

  let sharedNoteTimer: ReturnType<typeof setTimeout> | undefined;

  sharedNotes?.addEventListener('input', () => {
    if (sharedNoteStatus) sharedNoteStatus.textContent = 'Unsaved changes';

    window.clearTimeout(sharedNoteTimer);

    sharedNoteTimer = window.setTimeout(async () => {
      if (sharedNoteStatus) sharedNoteStatus.textContent = 'Saving...';

      const { error } = await supabase.from('client_notes').upsert({
        user_id: clientId,
        note_text: sharedNotes.value,
        updated_at: new Date().toISOString(),
      }, {
        onConflict: 'user_id',
      });

      if (error) {
        if (sharedNoteStatus) sharedNoteStatus.textContent = 'Could not save';

        console.error('ADMIN NOTE SAVE ERROR:', error);

        return;
      }

      if (sharedNoteStatus) sharedNoteStatus.textContent = 'Saved';

      window.setTimeout(() => {
        if (sharedNoteStatus?.textContent === 'Saved') sharedNoteStatus.textContent = '';
      }, 1500);
    }, 800);
  });

  const archiveToggle = card.querySelector<HTMLInputElement>('.archive-toggle');
  const archiveStatus = card.querySelector<HTMLElement>('.archive-status');

  archiveToggle?.addEventListener('change', async () => {
    archiveToggle.disabled = true;

    const archived = !archiveToggle.checked;

    const { error } = await supabase.from('profiles').update({
      archived,
    }).eq('id', clientId);

    archiveToggle.disabled = false;

    if (error) {
      archiveToggle.checked = !archiveToggle.checked;

      alert('Could not update account status.');

      console.error('ARCHIVE UPDATE ERROR:', error);

      return;
    }

    if (archiveStatus) {
      archiveStatus.textContent = archived ? 'Archived' : 'Active';
    }

    window.location.reload();
  });

  const saveButton = card.querySelector<HTMLButtonElement>('.save-client-button');
  const saveStatus = card.querySelector<HTMLElement>('.save-status');

  if (saveButton && saveStatus) {
    saveButton.addEventListener('click', async () => {
      saveButton.disabled = true;
      saveButton.textContent = 'Saving...';
      saveStatus.textContent = '';

      const getInput = (field: string) => card.querySelector<HTMLInputElement | HTMLSelectElement>(`[data-field="${field}"]`);

      const athleteName = getInput('athlete_name');
      const graduationYear = getInput('graduation_year');
      const packageInput = getInput('package');
      const bestEvents = getInput('best_events');
      const currentSchool = getInput('current_school');
      const currentTeam = getInput('current_team');
      const monthlySubscription = card.querySelector<HTMLInputElement>('[data-field="monthly_subscription"]');
      const subscriptionStatus = getInput('subscription_status');
      const nextSessionAt = getInput('next_session_at');
      const nextSessionLink = getInput('next_session_link');

      const updates = {
        athlete_name: athleteName?.value || null,
        graduation_year: graduationYear?.value ? Number(graduationYear.value) : null,
        package: packageInput?.value || null,
        best_events: bestEvents?.value || null,
        current_school: currentSchool?.value || null,
        current_team: currentTeam?.value || null,
        monthly_subscription: monthlySubscription?.checked ?? false,
        subscription_status: subscriptionStatus?.value || null,
        next_session_at: nextSessionAt?.value ? new Date(nextSessionAt.value).toISOString() : null,
        next_session_link: nextSessionLink?.value || null,
      };

      const { error } = await supabase.from('profiles').update(updates).eq('id', clientId);

      saveButton.disabled = false;
      saveButton.textContent = 'Save Profile Changes';

      if (error) {
        saveStatus.textContent = 'Could not save';

        console.error('ADMIN SAVE ERROR:', error);

        return;
      }

      saveStatus.textContent = 'Saved';

      window.setTimeout(() => {
        if (saveStatus.textContent === 'Saved') saveStatus.textContent = '';
      }, 1800);
    });
  }

  const timelineStatus = card.querySelector<HTMLElement>('.timeline-admin-status');
  const timelineCount = card.querySelector<HTMLElement>('.timeline-count');

  const updateTimelineCount = () => {
    const checkboxes = card.querySelectorAll<HTMLInputElement>('.admin-timeline-checkbox');
    const completed = card.querySelectorAll<HTMLInputElement>('.admin-timeline-checkbox:checked').length;

    if (timelineCount) timelineCount.textContent = `${completed} of ${checkboxes.length} complete`;
  };

  card.querySelectorAll<HTMLElement>('.admin-timeline-row').forEach((row) => {
    const timelineId = row.dataset.timelineId;
    const checkbox = row.querySelector<HTMLInputElement>('.admin-timeline-checkbox');
    const titleInput = row.querySelector<HTMLInputElement>('.admin-timeline-title');
    const deleteButton = row.querySelector<HTMLButtonElement>('.delete-timeline-button');
    const rowStatus = row.querySelector<HTMLElement>('.timeline-row-status');

    if (!timelineId) return;

    checkbox?.addEventListener('change', async () => {
      checkbox.disabled = true;

      if (rowStatus) rowStatus.textContent = 'Saving...';

      const { error } = await supabase.from('client_timeline').update({
        completed: checkbox.checked,
      }).eq('id', timelineId);

      checkbox.disabled = false;

      if (error) {
        checkbox.checked = !checkbox.checked;

        if (rowStatus) rowStatus.textContent = 'Error';

        console.error('TIMELINE UPDATE ERROR:', error);

        return;
      }

      if (rowStatus) rowStatus.textContent = 'Saved';

      updateTimelineCount();

      window.setTimeout(() => {
        if (rowStatus?.textContent === 'Saved') rowStatus.textContent = '';
      }, 1200);
    });

    titleInput?.addEventListener('change', async () => {
      if (!titleInput.value.trim()) return;

      titleInput.disabled = true;

      if (rowStatus) rowStatus.textContent = 'Saving...';

      const { error } = await supabase.from('client_timeline').update({
        title: titleInput.value.trim(),
      }).eq('id', timelineId);

      titleInput.disabled = false;

      if (error) {
        if (rowStatus) rowStatus.textContent = 'Error';

        console.error('TIMELINE TITLE ERROR:', error);

        return;
      }

      if (rowStatus) rowStatus.textContent = 'Saved';

      window.setTimeout(() => {
        if (rowStatus?.textContent === 'Saved') rowStatus.textContent = '';
      }, 1200);
    });

    deleteButton?.addEventListener('click', async () => {
      if (!window.confirm('Delete this timeline milestone?')) return;

      deleteButton.disabled = true;
      deleteButton.textContent = 'Deleting...';

      const { error } = await supabase.from('client_timeline').delete().eq('id', timelineId);

      if (error) {
        deleteButton.disabled = false;
        deleteButton.textContent = 'Delete';

        if (timelineStatus) timelineStatus.textContent = 'Could not delete milestone.';

        console.error('TIMELINE DELETE ERROR:', error);

        return;
      }

      row.remove();

      updateTimelineCount();

      if (timelineStatus) timelineStatus.textContent = 'Milestone deleted.';
    });
  });

  const newTimelineInput = card.querySelector<HTMLInputElement>('.new-timeline-input');
  const addTimelineButton = card.querySelector<HTMLButtonElement>('.add-timeline-button');

  addTimelineButton?.addEventListener('click', async () => {
    const title = newTimelineInput?.value.trim();

    if (!title) return;

    addTimelineButton.disabled = true;
    addTimelineButton.textContent = 'Adding...';

    const existingRows = card.querySelectorAll('.admin-timeline-row').length;

    const { error } = await supabase.from('client_timeline').insert({
      user_id: clientId,
      title,
      completed: false,
      sort_order: existingRows + 1,
    });

    addTimelineButton.disabled = false;
    addTimelineButton.textContent = 'Add Milestone';

    if (error) {
      if (timelineStatus) timelineStatus.textContent = 'Could not add milestone.';

      console.error('TIMELINE INSERT ERROR:', error);

      return;
    }

    if (newTimelineInput) newTimelineInput.value = '';

    window.location.reload();
  });

  newTimelineInput?.addEventListener('keydown', (event) => {
    if (event.key === 'Enter') addTimelineButton?.click();
  });

  card.querySelectorAll<HTMLElement>('.admin-document-row').forEach((row) => {
    const documentId = row.dataset.documentId;
    const storagePath = row.dataset.storagePath;
    const deleteButton = row.querySelector<HTMLButtonElement>('.delete-document-button');

    if (!documentId || !storagePath || !deleteButton) return;

    deleteButton.addEventListener('click', async () => {
      if (!window.confirm('Delete this document?')) return;

      deleteButton.disabled = true;
      deleteButton.textContent = 'Deleting...';

      const { error: storageError } = await supabase.storage.from('client-files').remove([storagePath]);

      if (storageError) {
        deleteButton.disabled = false;
        deleteButton.textContent = 'Delete';

        alert('Could not delete file from storage.');

        console.error('ADMIN STORAGE DELETE ERROR:', storageError);

        return;
      }

      const { error: databaseError } = await supabase.from('client_documents').delete().eq('id', documentId);

      if (databaseError) {
        deleteButton.disabled = false;
        deleteButton.textContent = 'Delete';

        alert('File deleted, but document record could not be removed.');

        console.error('ADMIN DOCUMENT DELETE ERROR:', databaseError);

        return;
      }

      row.remove();
    });
  });

  const uploadTitle = card.querySelector<HTMLInputElement>('.upload-title');
  const uploadCategory = card.querySelector<HTMLSelectElement>('.upload-category');
  const uploadFile = card.querySelector<HTMLInputElement>('.upload-file');
  const uploadButton = card.querySelector<HTMLButtonElement>('.upload-document-button');
  const uploadStatus = card.querySelector<HTMLElement>('.upload-status');

  uploadButton?.addEventListener('click', async () => {
    const title = uploadTitle?.value.trim();
    const category = uploadCategory?.value;
    const file = uploadFile?.files?.[0];

    if (!title) {
      if (uploadStatus) uploadStatus.textContent = 'Enter a title.';
      return;
    }

    if (!file) {
      if (uploadStatus) uploadStatus.textContent = 'Choose a PDF.';
      return;
    }

    if (file.type !== 'application/pdf') {
      if (uploadStatus) uploadStatus.textContent = 'PDF files only.';
      return;
    }

    uploadButton.disabled = true;
    uploadButton.textContent = 'Uploading...';

    if (uploadStatus) uploadStatus.textContent = '';

    const safeFileName = file.name.replace(/[^a-zA-Z0-9._-]/g, '-');
    const storagePath = `${clientId}/${Date.now()}-${safeFileName}`;

    const { error: uploadError } = await supabase.storage.from('client-files').upload(storagePath, file, {
      contentType: 'application/pdf',
      upsert: false,
    });

    if (uploadError) {
      uploadButton.disabled = false;
      uploadButton.textContent = 'Upload Document';

      if (uploadStatus) uploadStatus.textContent = 'Upload failed.';

      console.error('ADMIN FILE UPLOAD ERROR:', uploadError);

      return;
    }

    const { error: insertError } = await supabase.from('client_documents').insert({
      user_id: clientId,
      title,
      category,
      storage_path: storagePath,
    });

    if (insertError) {
      await supabase.storage.from('client-files').remove([storagePath]);

      uploadButton.disabled = false;
      uploadButton.textContent = 'Upload Document';

      if (uploadStatus) uploadStatus.textContent = 'Could not save document.';

      console.error('ADMIN DOCUMENT INSERT ERROR:', insertError);

      return;
    }

    if (uploadStatus) uploadStatus.textContent = 'Uploaded.';

    window.setTimeout(() => {
      window.location.reload();
    }, 600);
  });
});

const adminLogoutButton = document.querySelector<HTMLButtonElement>('#admin-logout-button');

adminLogoutButton?.addEventListener('click', async () => {
  adminLogoutButton.disabled = true;
  adminLogoutButton.textContent = 'Logging out...';

  const result = await actions.signOut();

  if (result.error || !result.data?.success) {
    adminLogoutButton.disabled = false;
    adminLogoutButton.textContent = 'Log Out';
    return;
  }

  window.location.href = '/login';
});
</script>

