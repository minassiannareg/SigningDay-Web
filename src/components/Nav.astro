---
// Single source of truth for site navigation.
const links = [
  { href: '/academic-index', label: 'SDA Compass' },
  { href: '/packages',       label: 'Packages' },
  { href: '/faq',            label: 'FAQ' },
  { href: '/contact',        label: 'Contact' },
  { href: '/login',          label: 'My Portal' }
];

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
---

<nav>
  <div class="wrap nav-inner">

    <a class="brand brand-logo" href="/" aria-label="Signing Day Advisors Home">
      <img src="/logos/SDA_logo_full.png" alt="Signing Day Advisors" />
    </a>

    <button
      class="nav-toggle"
      id="navToggle"
      type="button"
      aria-label="Toggle menu"
      aria-expanded="false"
      aria-controls="navLinks"
    >
      <svg
        viewBox="0 0 24 24"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        aria-hidden="true"
      >
        <path
          d="M3 6h18M3 12h18M3 18h18"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
        />
      </svg>
    </button>

    <div class="nav-links" id="navLinks">

      <a
        href="/academic-index"
        aria-current={path === '/academic-index' ? 'page' : undefined}
      >
        SDA Compass
      </a>

      <a
        href="/packages"
        aria-current={path === '/packages' ? 'page' : undefined}
      >
        Packages
      </a>


      <!-- ABOUT US DROPDOWN -->
      <div class="nav-dropdown">

        <a
          href="/team"
          class="nav-dropdown-main"
          aria-current={path === '/team' ? 'page' : undefined}
        >
          About Us

          <svg
            class="dropdown-arrow"
            viewBox="0 0 12 8"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="M1 1.5L6 6.5L11 1.5"
              stroke="currentColor"
              stroke-width="1.4"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </a>

        <div class="dropdown-menu">
          <a href="/team#network">Our Network</a>
        </div>

      </div>


      <a
        href="/faq"
        aria-current={path === '/faq' ? 'page' : undefined}
      >
        FAQ
      </a>

      <a
        href="/contact"
        aria-current={path === '/contact' ? 'page' : undefined}
      >
        Contact
      </a>

      <a
        href="/login"
        aria-current={path === '/login' ? 'page' : undefined}
      >
        My Portal
      </a>

    </div>

  </div>
</nav>


<style>

  .brand-logo{
    display:flex;
    align-items:center;
    flex-shrink:0;
    text-decoration:none;
  }

  .brand-logo img{
    display:block;
    width:auto;
    height:64px;
    max-width:280px;
    object-fit:contain;
  }

  /* ---------- ABOUT DROPDOWN: SHARED ---------- */

  .nav-dropdown{
    position:relative;
    display:flex;
    align-items:center;
  }

  .nav-dropdown-main{
    display:flex !important;
    align-items:center;
    gap:7px;
  }

  .dropdown-arrow{
    width:8px;
    height:5px;
    flex:none;
    transition:transform .2s ease;
  }

  .dropdown-menu{
    background:var(--navy);
  }

  .dropdown-menu a{
    white-space:nowrap;
    color:#C7D2DE !important;
    transition:color .15s ease, background .15s ease;
  }

  .dropdown-menu a:hover{
    color:var(--gold) !important;
    background:rgba(255,255,255,.04);
  }

  /* ---------- DESKTOP ONLY ---------- */

  @media (min-width:901px){

    /* Invisible bridge between About Us and its dropdown. */
    .nav-dropdown::after{
      content:"";
      position:absolute;
      top:100%;
      left:-15px;
      right:-15px;
      height:18px;
    }

    .dropdown-menu{
      position:absolute;
      top:calc(100% + 10px);
      left:50%;
      transform:translateX(-50%) translateY(-4px);
      width:max-content;
      min-width:145px;
      border:none;
      border-radius:0 0 4px 4px;
      padding:5px 0;
      opacity:0;
      visibility:hidden;
      pointer-events:none;
      box-shadow:0 8px 18px rgba(0,0,0,.12);
      transition:opacity .15s ease, transform .15s ease, visibility .15s ease;
      z-index:100;
    }

    .dropdown-menu a{
      display:block !important;
      padding:9px 16px !important;
      font-size:14px !important;
      line-height:1.3;
      text-align:center;
    }

    .nav-dropdown:hover .dropdown-menu,
    .nav-dropdown:focus-within .dropdown-menu{
      opacity:1;
      visibility:visible;
      pointer-events:auto;
      transform:translateX(-50%) translateY(0);
    }

    .nav-dropdown:hover .dropdown-arrow,
    .nav-dropdown:focus-within .dropdown-arrow{
      transform:rotate(180deg);
    }
  }

  /* ---------- TABLET / MOBILE ---------- */

  @media (max-width:900px){

    .nav-dropdown{
      display:block;
      width:100%;
      position:relative;
    }

    /* Make About Us occupy exactly the same row width/alignment as the other links. */
    .nav-dropdown-main{
      width:100%;
      box-sizing:border-box;
      justify-content:flex-start;
    }

    /* Critical: the submenu is CLOSED by default on narrow screens. */
    .dropdown-menu{
      position:static !important;
      top:auto !important;
      left:auto !important;
      right:auto !important;
      transform:none !important;
      width:100% !important;
      min-width:0 !important;
      margin:0 !important;
      padding:0 !important;
      border:0 !important;
      border-radius:0 !important;
      box-shadow:none !important;
      opacity:0 !important;
      visibility:hidden !important;
      pointer-events:none !important;
      max-height:0;
      overflow:hidden;
      transition:max-height .2s ease, opacity .16s ease, visibility .16s ease;
    }

    /* Override desktop hover/focus behavior completely on touch/narrow layouts. */
    .nav-dropdown:hover .dropdown-menu,
    .nav-dropdown:focus-within .dropdown-menu{
      opacity:0 !important;
      visibility:hidden !important;
      pointer-events:none !important;
      transform:none !important;
    }

    .nav-dropdown:hover .dropdown-arrow,
    .nav-dropdown:focus-within .dropdown-arrow{
      transform:none;
    }

    /* ONLY the JS-added class opens it. */
    .nav-dropdown.is-open .dropdown-menu,
    .nav-dropdown.is-open:hover .dropdown-menu,
    .nav-dropdown.is-open:focus-within .dropdown-menu{
      opacity:1 !important;
      visibility:visible !important;
      pointer-events:auto !important;
      max-height:90px;
    }

    .nav-dropdown.is-open .dropdown-arrow,
    .nav-dropdown.is-open:hover .dropdown-arrow,
    .nav-dropdown.is-open:focus-within .dropdown-arrow{
      transform:rotate(180deg);
    }

    /* Our Network uses the same left edge and row treatment as the other nav links. */
    .dropdown-menu a{
      display:block !important;
      width:100% !important;
      box-sizing:border-box;
      padding-left:0 !important;
      padding-right:0 !important;
      text-align:left !important;
      font-size:inherit !important;
      line-height:inherit !important;
    }
  }

</style>

<script>
  const navToggle = document.getElementById('navToggle');
  const navLinks = document.getElementById('navLinks');
  const aboutDropdown = document.querySelector('.nav-dropdown');
  const aboutMain = document.querySelector('.nav-dropdown-main');

  const isNarrow = () => window.matchMedia('(max-width: 900px)').matches;

  const closeAboutDropdown = () => {
    if (!aboutDropdown) return;
    aboutDropdown.classList.remove('is-open');
    aboutMain?.setAttribute('aria-expanded', 'false');
  };

  if (aboutMain) {
    aboutMain.setAttribute('aria-haspopup', 'true');
    aboutMain.setAttribute('aria-expanded', 'false');

    aboutMain.addEventListener('click', (event) => {
      /* Desktop keeps the current link + hover behavior. */
      if (!isNarrow()) return;

      /* On narrow screens, About Us acts only as the dropdown control. */
      event.preventDefault();
      event.stopPropagation();

      const open = aboutDropdown?.classList.toggle('is-open') ?? false;
      aboutMain.setAttribute('aria-expanded', open ? 'true' : 'false');
    });
  }

  if (navToggle && navLinks) {
    navToggle.addEventListener('click', () => {
      const open = navLinks.classList.toggle('open');
      navToggle.setAttribute('aria-expanded', open ? 'true' : 'false');

      /* Every fresh opening starts with About Us collapsed. */
      if (!open) closeAboutDropdown();
    });

    navLinks.querySelectorAll('a').forEach((a) => {
      a.addEventListener('click', () => {
        /* Don't close the whole mobile nav when About Us is being used as its toggle. */
        if (a === aboutMain && isNarrow()) return;

        navLinks.classList.remove('open');
        navToggle.setAttribute('aria-expanded', 'false');
        closeAboutDropdown();
      });
    });
  }

  window.addEventListener('resize', () => {
    /* Prevent stale mobile open state from carrying into desktop and back. */
    if (!isNarrow()) closeAboutDropdown();
  });
</script>
