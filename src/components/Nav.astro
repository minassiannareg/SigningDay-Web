---
// Single source of truth for site navigation.
const links = [
  { href: '/academic-index', label: 'SDA Compass' },
  { href: '/packages',       label: 'Packages' },
  { href: '/faq',            label: 'FAQ' },
  { href: '/contact',        label: 'Contact' },
  { href: '/login',          label: 'My Portal' }
];

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
---

<nav>
  <div class="wrap nav-inner">

    <a class="brand brand-logo" href="/" aria-label="Signing Day Advisors Home">
      <img src="/logos/SDA_logo_full.png" alt="Signing Day Advisors" />
    </a>

    <button
      class="nav-toggle"
      id="navToggle"
      type="button"
      aria-label="Toggle menu"
      aria-expanded="false"
      aria-controls="navLinks"
    >
      <svg
        viewBox="0 0 24 24"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        aria-hidden="true"
      >
        <path
          d="M3 6h18M3 12h18M3 18h18"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
        />
      </svg>
    </button>

    <div class="nav-links" id="navLinks">

      <a
        href="/academic-index"
        aria-current={path === '/academic-index' ? 'page' : undefined}
      >
        SDA Compass
      </a>

      <a
        href="/packages"
        aria-current={path === '/packages' ? 'page' : undefined}
      >
        Packages
      </a>


      <!-- ABOUT US DROPDOWN -->
      <div class="nav-dropdown">

        <a
          href="/team"
          class="nav-dropdown-main"
          aria-current={path === '/team' ? 'page' : undefined}
        >
          About Us

          <svg
            class="dropdown-arrow"
            viewBox="0 0 12 8"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="M1 1.5L6 6.5L11 1.5"
              stroke="currentColor"
              stroke-width="1.4"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </a>

        <div class="dropdown-menu">
          <a href="/team#network">Our Network</a>
        </div>

      </div>


      <a
        href="/faq"
        aria-current={path === '/faq' ? 'page' : undefined}
      >
        FAQ
      </a>

      <a
        href="/contact"
        aria-current={path === '/contact' ? 'page' : undefined}
      >
        Contact
      </a>

      <a
        href="/login"
        aria-current={path === '/login' ? 'page' : undefined}
      >
        My Portal
      </a>

    </div>

  </div>
</nav>


<style>

  .brand-logo{
    display:flex;
    align-items:center;
    flex-shrink:0;
    text-decoration:none;
  }

  .brand-logo img{
    display:block;
    width:auto;
    height:64px;
    max-width:280px;
    object-fit:contain;
  }


/* ---------- ABOUT DROPDOWN ---------- */

.nav-dropdown{
  position:relative;
  display:flex;
  align-items:center;
}

/*
  Invisible hover bridge.
  This fills the space between About Us and the dropdown,
  so the menu doesn't disappear while moving the mouse down.
*/
.nav-dropdown::after{
  content:"";
  position:absolute;
  top:100%;
  left:-15px;
  right:-15px;
  height:18px;
}

.nav-dropdown-main{
  display:flex !important;
  align-items:center;
  gap:7px;
}

.dropdown-arrow{
  width:8px;
  height:5px;
  transition:transform .2s ease;
}


/* ---------- DROPDOWN ---------- */

.dropdown-menu{
  position:absolute;

  /* close enough to feel attached, with hover bridge above */
  top:calc(100% + 10px);

  /* CENTER directly under About Us */
  left:50%;
  transform:translateX(-50%) translateY(-4px);

  width:max-content;
  min-width:145px;

  background:var(--navy);

  border:none;
  border-radius:0 0 4px 4px;

  padding:5px 0;

  opacity:0;
  visibility:hidden;
  pointer-events:none;

  box-shadow:0 8px 18px rgba(0,0,0,.12);

  transition:
    opacity .15s ease,
    transform .15s ease,
    visibility .15s ease;

  z-index:100;
}


/* ---------- DROPDOWN LINK ---------- */

.dropdown-menu a{
  display:block !important;

  padding:9px 16px !important;

  white-space:nowrap;

  font-size:14px !important;
  line-height:1.3;

  color:#C7D2DE !important;

  text-align:center;

  transition:
    color .15s ease,
    background .15s ease;
}

.dropdown-menu a:hover{
  color:var(--gold) !important;
  background:rgba(255,255,255,.04);
}


/* ---------- OPEN STATE ---------- */

.nav-dropdown:hover .dropdown-menu,
.nav-dropdown:focus-within .dropdown-menu{
  opacity:1;
  visibility:visible;
  pointer-events:auto;

  transform:translateX(-50%) translateY(0);
}

.nav-dropdown:hover .dropdown-arrow,
.nav-dropdown:focus-within .dropdown-arrow{
  transform:rotate(180deg);
}

</style>


<script>

  const navToggle = document.getElementById('navToggle');
  const navLinks = document.getElementById('navLinks');

  if (navToggle && navLinks) {

    navToggle.addEventListener('click', () => {

      const open = navLinks.classList.toggle('open');

      navToggle.setAttribute(
        'aria-expanded',
        open ? 'true' : 'false'
      );

    });


    navLinks.querySelectorAll('a').forEach((a) =>

      a.addEventListener('click', () => {

        navLinks.classList.remove('open');

        navToggle.setAttribute(
          'aria-expanded',
          'false'
        );

      })

    );

  }

</script>